{% extends "base.html.twig" %}

{% block javascripts_head %}

    {{ parent() }}

    {% javascripts
    '@TechemCoreBundle/Resources/public/js/jquery-1.11.0.min.js' %}
    <script type="text/javascript" src="{{ asset_url }}"></script>
    {% endjavascripts %}

    <!--[if lt IE 9]>
    <script src="{{ asset('bundles/techemcore/ie8-responsive-file-warning.js') }}"></script><![endif]-->

    <!-- HTML5 shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
    <script src="//oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="//oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

{% endblock %}

{% block javascripts_foot %}
    {{ parent() }}
    {% javascripts
    '@TechemCoreBundle/Resources/public/js/gsap/main-gsap.js'
    '@TechemCoreBundle/Resources/public/js/jquery-ui/js/jquery-ui-1.10.3.minimal.min.js'
    '@TechemCoreBundle/Resources/public/js/bootstrap.js'
    '@TechemCoreBundle/Resources/public/js/joinable.js'
    '@TechemCoreBundle/Resources/public/js/neon-api.js'
    '@TechemCoreBundle/Resources/public/js/resizeable.custom.js'
    '@TechemCoreBundle/Resources/public/js/neon-custom.js'
    '@TechemCoreBundle/Resources/public/js/custom.js'
    '@TechemCoreBundle/Resources/public/js/bootstrap-datepicker-release/js/bootstrap-datepicker.js' %}
    <script type="text/javascript" src="{{ asset_url }}"></script>
    {% endjavascripts %}

{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="//fonts.googleapis.com/css?family=Noto+Sans:400,700,400italic">
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css">

    {% stylesheets
    'bundles/techemcore/js/jquery-ui/css/no-theme/jquery-ui-1.10.3.custom.min.css'
    'bundles/techemcore/css/font-icons/entypo/css/entypo.css'
    'bundles/techemcore/css/bootstrap.css'
    'bundles/techemcore/css/neon-core.css'
    'bundles/techemcore/css/neon-theme.css'
    'bundles/techemcore/css/neon-forms.css'
    'bundles/techemcore/css/skins/white.css'
    'bundles/techemcore/fonts/techem-fontello/css/fontello.css'
    'bundles/techemcore/css/custom.css'
    'bundles/techemcore/css/main.css'
    filter='cssrewrite' %}
    <link rel="stylesheet" href="{{ asset_url }}"/>
    {% endstylesheets %}
{% endblock %}

{% block body_classes %}
    {{ parent() }}
    login-page
{% endblock %}

{% block body %}
    <header></header>
    {% block main_content %}{% endblock %}
    <nav id="footer" class="navbar footer">
        <ul>
            <li><a href="https://www.techem.fr/mentions-legales.html" target="_blank">{{ "Mentions légales"|trans }}</a> - <a href="https://www.techem.fr/politique-de-confidentialite.html" target="_blank">Politique de confidentialité</a></li>
            <!--<li><a href="{{ path("TechemCoreBundle_Front_legal_notices") }}">{{ "Mentions légales"|trans }}</a> - <a href="https://www.techem.fr/politique-de-confidentialite.html" target="_blank">Politique de confidentialité</a></li>-->
            {#<li><a href="">Limitation de responsabilité</a></li>#}
            <!--<li><a href="">{{ "Politique de confidentialité"|trans }}</a></li>-->
            <!--<li><a href="">{{ "Contact"|trans }}</a></li>-->
        </ul>
        <ul class="flags">
            <li style="padding-top: 0">
                <a style="" href="{{ path('app_login') }}">
                    <img style="   max-width: 40px;
    margin-left: 10px;" src="{{ asset('bundles/techemcore/images/flags/flag-fr.png') }}"/>
                </a>
                <a href="{{ path('app_login', { '_locale': 'en' }) }}">
                    <img style="max-width: 40px;
    margin-left: 10px;" src="{{ asset('bundles/techemcore/images/flags/flag-gb.png') }}"/>
                </a>
            </li>

        </ul>
    </nav>
{% endblock %}