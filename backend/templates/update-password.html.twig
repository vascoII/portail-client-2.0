<div>
<br />
Rappel : <br />Votre mot de passe doit être composé d'au moins 8 caractères et contenir au moins une majuscule, une minuscule et un chiffre.
<br /><br />
</div>
<form class="form" action="{{ path('update_password') }}" method="post">
    
	{% if app.token.attribute('soap.user').Info is defined and app.token.attribute('soap.user').Info == 'PASSWORD_EXPIRED' %}
	        <div class="has-error">
            <div class="help-block">
                Votre mot de passe est expiré, merci de bien vouloir le changer
            </div>
        </div>
	{% endif %}
	{% if not form.vars.valid %}

        <div class="has-error">
            <div class="help-block">
                {{ form_errors(form) }}
            </div>
        </div>
    {% elseif success == true %}
        <div class="alert alert-success" role="alert">
            <span>{{ "Votre mot de passe a été modifié"|trans }}</span>
        </div>

    {% endif %}
    {{ form_row(form.password.first) }}
    {{ form_row(form.password.second) }}
    <div class="form-group">
        <div class="col-xs-12">
            <input class="submit btn-lg" type="submit" value={{ "Modifier"|trans }} />
            <span class="text-danger">* {{ "champs obligatoire"|trans }}</span>
        </div>
    </div>
    {{ form_rest(form) }}
</form>
