{% extends "base.html.twig" %}

{% block javascripts_head %}
    {{ parent() }}

    <script src="{{ asset('bundles/techemcore/ie8-responsive-file-warning.js') }}"></script>

    <!--[if lt IE 9]>
        <script src="//oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="//oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
{% endblock %}

{% block javascripts_foot %}
    {{ parent() }}

    <script src="{{ asset('bundles/techemcore/js/gsap/main-gsap.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/jquery-ui/js/jquery-ui-1.10.3.minimal.min.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/bootstrap.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/joinable.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/neon-api.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/resizeable.custom.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/neon-custom.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/custom.js') }}"></script>
    <script src="{{ asset('bundles/techemcore/js/bootstrap-datepicker-release/js/bootstrap-datepicker.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="//fonts.googleapis.com/css?family=Noto+Sans:400,700,400italic">
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css">
    
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/js/jquery-ui/css/no-theme/jquery-ui-1.10.3.custom.min.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/font-icons/entypo/css/entypo.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/bootstrap.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/neon-core.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/neon-theme.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/neon-forms.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/skins/white.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/fonts/techem-fontello/css/fontello.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/custom.css') }}" />
    <link rel="stylesheet" href="{{ asset('bundles/techemcore/css/main.css') }}" />
{% endblock %}

{% block body_classes %}
    {{ parent() }}
    default-page
{% endblock %}

{% block body %}
    <header></header>
    {% block main_content %}{% endblock %}
    <nav id="footer" class="navbar footer">
        {% include 'base_footer.html.twig' %}
    </nav>
{% endblock %}
