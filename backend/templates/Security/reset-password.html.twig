{% extends "Security/base.html.twig" %}

{% form_theme form 'Form/fields.html.twig' %}

{% block body_classes %}
    {{ parent() }}
    reset-page
{% endblock %}

{% block main_content %}

    <div class="main-content">
        <a href="{{ path('TechemCoreBundle_TableauBordClient_index') }}" class="logo">
            <img src="{{ asset('bundles/techemcore/images/fidesio/logo.svg') }}"/>
        </a>

        <form action="{{ path('reset_password') }}" method="post" class="form">
            <div class="form-content">
                <h3 class="title" style="font-family:Lucida Grande, Arial, Verdana, sans-serif;">{{ "RÉINITIALISER SON MOT DE PASSE"|trans }}</h3>

                <div class="description"></div>

                {% if not form.vars.valid %}
                    <div class="has-error">
                        <div class="help-block">
                            {{ form_errors(form) }}
                        </div>
                    </div>
                {% elseif success %}
                    <div class="has-success">
                        <div class="help-block">
                            {{ "Un email contenant un lien de réinitialisation de mot de passe vous sera adressé sur votre boite email d'ici quelques minutes. Merci de vérifier également votre dossier antispam." }}
                        </div>
                    </div>
                {% endif %}

                {{ form_row(form.email) }}
                {{ form_rest(form) }}
            </div>

            <input type="submit" name="login" value="ENVOYER" class="submit" />
        </form>
    </div>

{% endblock %}
