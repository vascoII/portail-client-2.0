<div class="panel panel-body status-gauge {{ classes }}">
    {% if value == -1 %}<div class="disabled"></div>{% endif %}
    <a href="{% if link is defined %}{{ link }}{% else %}#{% endif %}">
        <div class="panel-default">
            <div class="panel-body">
                <div class="taux">{% if value == -1 %}0{% else %}{{ value }}{% endif %}</div>
                <div class="canvas"><canvas width="139" height="113" data-options=" {{ gauge|json_encode() }}"></canvas></div>
                <div class="intitule"><span>{{ label|raw }}</span></div>
            </div>
        </div>
    </a>
</div>