{% extends 'base.html.twig' %}

{% form_theme form 'Form/fields.html.twig' %}

{% block body__main_menu %}
        <li class="category ">
            <a class="operateurCreate" href="{{ path('TechemCoreBundle_Operator_index') }}">
                <i class="icon-list2"></i><span class="title ">{{ "Liste des gestionnaires"|trans }}</span>
            </a>
        </li>
        <li class="active with-icon ">
            <a  class="operateurCreateIcon" href="#">
                <i class="icon-user"></i><span class="title">{{ "Création de compte"|trans }}</span>
            </a>
        </li>
        <li class="category">
            <a  class="operateurCreateIcon" href="{{ path('update_password') }}">
                <i class="icon-pencil-1"></i><span class="title">{{ "Modifier mot de passe"|trans }}</span>
            </a>
        </li>
{% endblock %}

{% block breadcrumb_mobile %}
    <div class="btn btn-primary btn-lg dropdown-toggle hidden-lg hidden-md" id="dropdownMenu3" data-toggle="dropdown">
        <i class="pull-right icon-arrow"></i>
        <h3>{{ "Création de compte"|trans }}</h3>
    </div>
    <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu3">
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_Operator_index') }}">
                    {{ "Liste des gestionnaires"|trans }}</a></h3>
        </li>
    </ul>
{% endblock %}

{% block main_content %}
    <ul class="breadcrumb hidden-xs">
        <li><a href="{{ path('TechemCoreBundle_Operator_index') }}">
                {{ "Liste des gestionnaires"|trans }}
            </a></li>
        <li><a href="#">{{ "Création de compte"|trans }}</a></li>
    </ul>
    <span class="clearfix"></span>

    <div class="header">
        <h2 class="title">{{ "Création de compte"|trans }}</h2>
    </div>

    <div class="row">
        <div class="col-sm-6 operator-view-area">
            {% if success is not null %}
                {% if success %}
                    <div class="has-success">
                        <div class="help-block">
                            {{ "Le compte a été créé"|trans }}.
                        </div>
                    </div>
                {% elseif not success %}
                    <div class="has-error">
                        <div class="help-block">
                            {{ "Le compte n'a pas pu être créé"|trans }}.
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            <form class="form" action="{{ path('TechemCoreBundle_Operator_create') }}" method="post">
                {% if not form.vars.valid %}
                    <div class="has-error">
                        <div class="help-block">
                            {{ form_errors(form) }}
                        </div>
                    </div>
                {% endif %}

                {#{{ form_row(form.gender) }}#}
                {{ form_row(form.job) }}
                {{ form_row(form.lastname) }}
                {{ form_row(form.firstname) }}
                {{ form_row(form.phone) }}
                {{ form_row(form.email.first) }}
                {{ form_row(form.email.second) }}
                <div class="form-group">
                    <div class="col-xs-12">
                        <input class="submit btn-lg" type="submit" value='{{ "Créer le compte"|trans }}'/>
                        <span class="text-danger">* {{ "champs obligatoire"|trans }}</span>
                    </div>
                </div>
                {{ form_rest(form) }}
            </form>
        </div>
    </div>
{% endblock %}