{% extends 'base.html.twig' %}

{% form_theme form 'Form/fields.html.twig' %}

{% block body__main_menu %}
    <li class="category">
        <a class="operateurCreate" href="{{ path('TechemCoreBundle_Operator_index') }}">
            <i class="icon-list2"></i><span class="title ">{{ "Liste des gestionnaires"|trans }}</span>
        </a>
    </li>
    <li class="category">
        <a class="operateurCreateIcon" href="{{ path('TechemCoreBundle_Operator_create') }}">
            <i class="icon-user"></i><span class="title">{{ "Création de compte"|trans }}</span>
        </a>
    </li>
    <li class="active category">
        <a  class="operateurCreateIcon" href="#">
            <i class="icon-pencil-1"></i><span class="title">{{ "Mon Compte"|trans }}</span>
        </a>
    </li>
{% endblock %}

{% block breadcrumb_mobile %}
    <div class="btn btn-primary btn-lg dropdown-toggle hidden-lg hidden-md" id="dropdownMenu3" data-toggle="dropdown">
        <i class="pull-right icon-arrow"></i>
        <h3>{{ "Modifier mot de passe"|trans }}</h3>
    </div>
    <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu3">
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_Operator_index') }}">
                    {{ "Liste des gestionnaires"|trans }}</a></h3>
        </li>
    </ul>
{% endblock %}

{% block main_content %}
    <ul class="breadcrumb hidden-xs">
        <li><a href="{{ path('TechemCoreBundle_Operator_index') }}">{{ "Liste des gestionnaires"|trans }}</a></li>
        <li><a href="#">{{ "Mon Compte"|trans }}</a></li>
    </ul>
    <span class="clearfix"></span>
{% if demo is defined %}

    <div class="header">
        <h2 class="title">{{ "Mon profil et mes notifications"|trans }}</h2>
    </div>

    <div class="row">
        <div class="col-sm-6 operator-view-area">

		{% if app.token.attribute('soap.user').UserName is defined or app.token.attribute('soap.user').FirstName is defined %}

			<div class="form-group">
				<label class="col-xs-2">Prénom</label>
				<div class="controls col-xs-10 buttonIn">
					<input type="text" class="form-control" placeholder="Prénom" name="" data-field="" required="" value="{{ app.token.attribute('soap.user').FirstName is defined ? app.token.attribute('soap.user').FirstName : '' }}">
				</div>
			</div>
			<br />
			<br />
			<div class="form-group">
				<label class="col-xs-2">Nom</label>
				<div class="controls col-xs-10 buttonIn">
					<input type="text" class="form-control" placeholder="Nom" name="" data-field="" required="" value="{{ app.token.attribute('soap.user').UserName is defined ? app.token.attribute('soap.user').UserName : '' }}">
				</div>
			</div>
			<br />
			<br />
			<div class="form-group">
				<label class="col-xs-2">Email</label>
				<div class="controls col-xs-10 buttonIn">
					<input disabled type="text" class="form-control" placeholder="Email" name="" data-field="" required="" value="demo@techem.fr>">
				</div>
			</div>
			<br />
			<br />
			<h4>Activation des notifications</h4>
			<div class="form-group checkbox-replace neon-cb-replacement">
				<label class="col-xs-3">Rapport Interventions<br/>Mensuel</label>
				<div class="controls col-xs-9 buttonIn">
					<label class="cb-wrappe">
					<input type="Checkbox" class="form-control" placeholder="NotifInter" name="" data-field="" >
					<div class="checked"></div></label>
				</div>
			</div>
			<br />
			<br />
			<br />
			<br />
			<div class="form-group checkbox-replace neon-cb-replacement">
				<label class="col-xs-3">Alertes fuites<br/>Hebdomadaire</label>
				<div class="controls col-xs-9 buttonIn">
					<label class="cb-wrappe">
					<input type="Checkbox" class="form-control" placeholder="" name="" data-field="" >
					<div class="checked"></div></label>
				</div>
			</div>
			<br />
			<br />

			

				
		{% endif %}

        </div>
	</div>
	<span class="clearfix"></span>
{% endif %}

    <h2 class="title">{{ "Modification mot de passe"|trans }}</h2>


    <div class="row">
        <div class="col-sm-6 operator-view-area">
            {#{% if success is not null %}#}
                {#{% if success %}#}
                    {#<div class="has-success">#}
                        {#<div class="help-block">#}
                            {#Le compte a été créé.#}
                        {#</div>#}
                    {#</div>#}
                {#{% elseif not success %}#}
                    {#<div class="has-error">#}
                        {#<div class="help-block">#}
                            {#Le compte n'a pas pu être créé.#}
                        {#</div>#}
                    {#</div>#}
                {#{% endif %}#}
            {#{% endif %}#}
            {% include 'update-password.html.twig' %}

        </div>
    </div>
	
{% endblock %}