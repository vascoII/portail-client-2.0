<div class="panel">

    {% if panel.Tot_URepart != '-1' %}
        <div class="panel-text">
            <div class="panel">

                <div class="inner">
                    <div class="block-title">{{ 'Données De la dernière répartition'|trans }}</div>
                    <br>
                    <div class="actions">
                        <a href="{{ path('TechemCoreBundle_Occupant_repart_releve', {'pkImmeuble': logement.Immeuble.PkImmeuble, 'pkOccupant': logement.Occupant.PkOccupant}) }}" target="_blank" class="print">
                            <button type="submit" class="btn-primary btn">
                                <i class="icon-print"></i> {{ "Télécharger le décompte"|trans }}
                            </button>
                        </a>

                        <a href="{{ path('TechemCoreBundle_Logement_guide', {'file': 'GuideOccupant.pdf'}) }}" target="_blank" class="print">
                            <button type="submit" class="btn-primary btn">
                                <i class="icon-print"></i> {{ "Télécharger le guide occupant"|trans }}
                            </button>
                        </a>
                    </div>
                    <br>
                    <div class="title">{{ "Données de l’immeuble"|trans }}</div>

                    <div class="row">
                        <div class="col-md-6 panel-left">
                            <div class="item">{{ 'Total des unités de répartition de l’immeuble'|trans }} : <strong>{{ panel.Tot_URepart|number_format(0, '.', ' ') }}</strong></div>

                            <div class="item">{{ "Total tantièmes chauffage"|trans }} : <strong>{{ panel.Tot_TantChauff|number_format(0, '.', ' ') }}</strong></div>

                            <div class="item">{{ "Prix unitaire du tantième "|trans }}: <strong>{{ panel
                                    .PU_Tant|number_format(5, '.', ' ') }} €</strong></div>

                            <div class="item">{{ "Prix de l'unité de répartition"|trans }} : <strong>{{ panel.Prix_URepart|number_format(5, '.', ' ') }} €</strong></div>
                        </div>

                        <div class="col-md-6 panel-right">
                            <div class="item">{{ "Prix de l’abonnement"|trans }} : <strong>{{ panel.Prix_Abonn|number_format(2, '.', ' ') }} €</strong></div>

                            <div class="item">{{ "Montant à répartir aux tantièmes"|trans }} : <strong>{{ panel.Mont_ARepartTant|number_format(2, '.', ' ') }} €</strong></div>

                            <div class="item">{{ "Part répartie en fonction des consommations"|trans }} : <strong>{{ panel.Part_RepartConsos|number_format(2, '.', ' ') }} €</strong></div>

                            <div class="item">{{ "Coût total du combustible"|trans }} : <strong>{{ panel.CT_Combust|number_format(2, '.', ' ') }} €</strong></div>
                        </div>
                    </div>
                </div>

                <div class="inner">
                    <div class="title">{{ "Données du logement"|trans }}</div>

                    <div class="row">
                        <div class="col-md-6 panel-left">
                            <div class="item">{{ "Unités de répartitions pour le logement"|trans }} : <strong>{{ panel.URepartLog }}</strong></div>

                            <div class="item">{{ "Tantièmes logement"|trans }}  : <strong>{{ panel.TantLog }}</strong></div>
                        </div>

                        <div class="col-md-6 panel-right">
                            <div class="item">{{ "Prix du chauffage au tantième "|trans }}: <strong>{{ panel
                                    .Prix_ChauffTantLog|number_format(2, '.', ' ') }}
                                    €</strong></div>

                            <div class="item">{{ "Cout du chauffage"|trans }} : <strong>{{ panel
                                    .CT_ChauffLog|number_format(2, '.', ' ') }}
                                    €</strong></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    {% endif %}

    {% set Appareils = panel.ListeInfosAppareils.infosAppareilCET %}

    <div class="graph">
        <h3>{{ "Evolution des index"|trans }}</h3><br><br>
        <div style="width: 100%; height: 80px;">
            <form class="form-filter{{ consoTab.id }}" name="form-filter" method="post">
                <p>
                    <label for="date_from">{{ "Du"|trans }}</label>
                    <input id="date_from" type="text" name="date_from{{ consoTab.id }}" class="datepicker form-control" style="height: 30px;" data-date-format="dd/mm/yyyy"
                           value="{% if consoTab.EvolutionChartData.chartControl.state.lowDate %}{{ consoTab.EvolutionChartData.chartControl.state.lowDate }}{% endif %}"/>
                    <i class="fa fa-calendar"></i>
                    <br class="hidden-lg hidden-md hidden-sm"/><br class="hidden-lg hidden-md hidden-sm"/>
                    <label for="date_to">{{ "au"|trans }}</label>
                    <input id="date_to" type="text" name="date_to{{ consoTab.id }}" class="datepicker form-control" style="height: 30px;" data-date-format="dd/mm/yyyy"
                           value="{% if consoTab.EvolutionChartData.chartControl.state.highDate %}{{ consoTab.EvolutionChartData.chartControl.state.highDate }}{% endif %}"/>
                    <i class="fa fa-calendar"></i>
                    <button name="filtreur" id="filtreur" type="submit" class="btn btn-primary">{{ "Filtrer"|trans
                        }}</button>
                </p>
            </form>
        </div>

        {% if NbCompteurs > 1 %}
            <div class="row">
                <div class="pull-right">
                    <br class="hidden-lg hidden-md hidden-sm"/><br class="hidden-lg hidden-md hidden-sm"/>
                    <label for="choosed_compteur{{ consoTab.id }}">{{ "N° Série : "|trans }}</label>
                    <select id="choosed_compteur{{ consoTab.id }}" name="choose_compteur{{ consoTab.id }}" class="charts-select">
                        {% for appareil in Appareils %}
                            <option value="{{ appareil.Appareil.Numero|replace({'-':'_'}) }}">
                                {% if appareil.Appareil.Numero == '0000000' %}
                                    Tous les appareils
                                {% else %}
                                    {% if appareil.Appareil is defined and appareil.Appareil.Emplacement is defined %}
                                        {{ appareil.Appareil.Numero }} - {{ appareil.Appareil.Emplacement }}
                                    {% else %}
                                        N° {{ appareil.Appareil.Numero }}
                                    {% endif %}
                                {% endif %}
                            </option>
                        {% endfor %}
                    </select>
                    <br class="hidden-lg hidden-md hidden-sm"/><br class="hidden-lg hidden-md hidden-sm"/>
                </div>
            </div>
        {% endif %}

        {% for appareil in Appareils %}
            <div id="chart_compteur_dashboard{{ appareil.Appareil.Numero|replace({'-':'_'}) }}" class="charts{{ consoTab.id }} consochart{{ consoTab.id }}" data-compteur="{{ appareil.Appareil.Numero|replace({'-':'_'}) }}" {% if loop.index0 > 0 %}style="display: none"{% endif %}>
                <div id="chart_compteur_control{{ appareil.Appareil.Numero|replace({'-':'_'}) }}" class="chart-control" style="display: none;"></div>
                <div id="chart_compteur_conso{{ appareil.Appareil.Numero|replace({'-':'_'}) }}" style="width: 100%; height: 350px;"></div>
            </div>
        {% endfor %}

        <div id="chart_logement_dashboard{{ consoTab.id }}" class="charts{{ consoTab.id }}" style="display: none">
            <div id="chart_logement_control{{ consoTab.id }}" class="chart-control" style="display: none;"></div>
            <div id="chart_logement_conso{{ consoTab.id }}" style="width: 100%; height: 350px;"></div>
        </div>
    </div>

    {% set r1repart = 0 %}
    {% set r2repart = 0 %}
    {% if panel.ConsosPieces.consoPieceRepart is defined %}
        {% if panel.ConsosPieces.consoPieceRepart is iterable %}
            {% for consoPieceRepart in panel.ConsosPieces.consoPieceRepart %}
                {% if consoPieceRepart.R2 is defined and consoPieceRepart.R2.Conso > 0 %}
                    {% set r2repart = 1 %}
                {% endif %}
                {% if consoPieceRepart.R1 is defined and consoPieceRepart.R1.Conso > 0 %}
                    {% set r1repart = 1 %}
                {% endif %}
            {% endfor %}
        {% else %}
            {% if panel.ConsosPieces.consoPieceRepart.R1 is defined and panel.ConsosPieces.consoPieceRepart.R1.Conso > 0 %}
                {% set r1repart = 1 %}
            {% endif %}
            {% if panel.ConsosPieces.consoPieceRepart.R2 is defined and panel.ConsosPieces.consoPieceRepart.R2.Conso > 0 %}
                {% set r2repart = 1 %}
            {% endif %}
        {% endif %}
    {% endif %}
    {% if r1repart == 1 or r2repart == 1 %}
        <div class="panel-chart">
            <div class="panel">
                <div class="block-title">{{ "Consommation par pièces comparée à la période précédente"|trans }}</div>
                <br>
                <div id="graph_repart_conso" style="width: 90%; height: {{ Appareils|length * (50 + r2repart * 50) }}px;"></div>
            </div>
        </div>
    {% endif %}


    <script type="text/javascript">

        {#google.setOnLoadCallback(drawChart{{ consoTab.id }});#}
        function drawChart{{ consoTab.id }}() { // Initialise le graphique avec des paramètres par défaut
            var drawn = false;
            var data = new google.visualization.DataTable(),
                options = {
                    title: '', // Titre du graphique
                    chartArea: {
                        top: '25'
                    },
                    vAxis: {
                        title: 'en {{ unite }}'
                    },
                    hAxis: {
                        title: 'Date', // Titre des abscisses
                        format: 'dd/MM/y', // Format des dates
                        viewWindowMode: 'maximized'
                    },
                    pointSize: 15, // Taille d'un point
                    series: {
                        0: {
                            color: '{{ color }}'
                        },
                        1: {
                            color: '#000000',
                            lineWidth: 0,
                            pointSize: 5
                        }
                    },
                    legend: {
                        position: "bottom",
                        alignment: "end"
                    },
                    tooltip: {trigger: 'selection', isHtml: true}
                };

            data.addColumn('date', 'Date');
            data.addColumn('number', '{{ "Index"|trans }}' );
            data.addColumn({'type': 'string', 'role': 'tooltip', 'p': {'html': true}});

            function updateWrapper(formId) { // Quand on appuie sur "FILTRER", déclenche cette fonction

                var hotwFromValue = $("input[name='date_fromhotw']").val();
                var hotwToValue = $("input[name='date_tohotw']").val();
                var coldwFromValue = $("input[name='date_fromcoldw']").val();
                var coldwToValue = $("input[name='date_tocoldw']").val();

                if (formId == 'coldw') {
                    hotwFromValue = coldwFromValue;
                    hotwToValue = coldwToValue;
                }
                else {
                    coldwFromValue = hotwFromValue;
                    coldwToValue = hotwToValue;
                }

                if ($("input[name='date_from" + formId + "']").val().length > 0 || $("input[name='date_to" + formId + "']").val().length > 0) {

                    var timelowval = $('input[name="date_from' + formId + '"]').datepicker("getDate").getTime(), // /!\ Valeur exprimée en millisecondes /!\
                        timehighval = $('input[name="date_to' + formId + '"]').datepicker("getDate").getTime();

                    $(".consochart" + formId + "").each(function () {
                        var numero = $(this).attr('data-compteur');
                        if (numero != "all") {
                            eval("var result = isCreated" + numero);
                            if (result !== false) {
                                if (!isNaN(timehighval) && !isNaN(timelowval)) {
                                    eval("controlWrapper" + numero + ".setState({'lowValue': " + timelowval + ", 'highValue': " + timehighval + "})");
                                } else {
                                    if (!isNaN(timelowval)) {
                                        eval("controlWrapper" + numero + ".setState({'lowValue': " + timelowval + "})");
                                    }
                                    if (!isNaN(timehighval)) {
                                        eval("controlWrapper" + numero + ".setState({'highValue': " + timehighval + "})");
                                    }
                                }
                                eval("controlWrapper" + numero + ".draw()");
                            }
                        }
                    });

                }
            }

            {% for chartData in consoTab.EvolutionChartData.data %}
            {% if chartData.index %}
            var date = new Date({{ chartData.label }}); // Label correspond à un temps exprimé en millisecondes
            data.addRow([
                date, {{ chartData.index }}, customTooltip(('0' + date.getDate()).slice(-2) + ' / ' + ('0' + (date.getMonth() + 1)).slice(-2) + ' / ' + date.getFullYear() + '<br/>Conso: {{ chartData.consoRaw }}<br/>Index: {{ chartData.indexRaw }}')
            ]);
            {% endif %}
            {% endfor %}

            function customTooltip(value) {
                return '<div style="border-radius:3px;padding:5px;width:90px;background: #717b87;color: #ffffff;text-align: center;position:absolute;left:-45px;bottom:7px;">' + value + '</div>';
            }

            var dashboard = new google.visualization.Dashboard(document.getElementById('chart_logement_dashboard{{ consoTab.id }}')),
                controlWrapper = new google.visualization.ControlWrapper({
                    'controlType': 'DateRangeFilter',
                    'containerId': 'chart_logement_control{{ consoTab.id }}',
                    'options': {
                        'filterColumnLabel': 'Date',
                        'ui': {
                            'label':  'Période de consommation affichée',
                            'format': {
                                'pattern': 'dd/MM/y'
                            }
                        }
                    }
                });

            var chartWrapper = new google.visualization.ChartWrapper({
                'chartType': 'LineChart',
                'containerId': 'chart_logement_conso{{ consoTab.id }}',
                'options': options
            });

            dashboard.bind(controlWrapper, chartWrapper);
            dashboard.draw(data);

            {#// Fix chart not drawn correctly#}
            {#if ($('#{{ consoTab.id }}').hasClass('active')) {#}
            {#dashboard.draw(data);#}
            google.visualization.events.addListener(dashboard, 'ready', function () {
                if (!drawn) {
                    {%- if consoTab.EvolutionChartData.chartControl.state.lowValue -%}
                    controlWrapper.setState({
                        'lowValue': {{ consoTab.EvolutionChartData.chartControl.state.lowValue }},
                        'highValue': {{ consoTab.EvolutionChartData.chartControl.state.highValue }}
                    });
                    controlWrapper.draw();
                    {%- endif -%}
                    drawn = true;
                }
            });

            {#} else {#}
            {#$('a[href=#{{ consoTab.id }}]').one('shown.bs.tab', function () {#}
            {#dashboard.draw(data);#}
            {% if NbCompteurs > 1 %}
            var x11111 = $("#choosed_compteur{{ consoTab.id }}").val(),
                timelowval = {{ consoTab.EvolutionChartData.chartControl.state.lowValue }},
                timehighval = {{ consoTab.EvolutionChartData.chartControl.state.highValue }};
            if (typeof window["controlWrapper" + + x11111] !== "undefined") {
                if (!isNaN(timehighval) && !isNaN(timelowval)) {
                    eval("controlWrapper" + x11111 + ".setState({'lowValue': " + timelowval + ", 'highValue': " + timehighval + "})");
                } else {
                    if (!isNaN(timelowval)) {
                        eval("controlWrapper" + x11111 + ".setState({'lowValue': " + timelowval + "})");
                    }
                    if (!isNaN(timehighval)) {
                        eval("controlWrapper" + x11111 + ".setState({'highValue': " + timehighval + "})");
                    }
                }
                eval("controlWrapper" + x11111 + ".draw()");
            }
            {% endif %}
            google.visualization.events.addListener(dashboard, 'ready', function () {
                if (!drawn) {
                    {%- if consoTab.EvolutionChartData.chartControl.state.lowValue -%}
                    controlWrapper.setState({
                        'lowValue': {{ consoTab.EvolutionChartData.chartControl.state.lowValue }},
                        'highValue': {{ consoTab.EvolutionChartData.chartControl.state.highValue }}
                    });
                    controlWrapper.draw();
                    {%- endif -%}
                    drawn = true;
                }
            });
//                });
//            }

            {% if NbCompteurs > 0 %}
            {# Fix : use ajax load for chart instead of loading all chart on page load#}
            {% for appareil in Appareils %}
            var isCreated{{ appareil.Appareil.Numero|replace({'-':'_'}) }} = false;
            // {{ appareil.SerieConsos.ValeursXYL|length }}
            {% if appareil.SerieConsos.ValeursXYL is defined and appareil.SerieConsos.ValeursXYL|length > 0%}
            var drawn{{ appareil.Appareil.Numero|replace({'-':'_'}) }} = false;
            var data{{ appareil.Appareil.Numero|replace({'-':'_'}) }} = new google.visualization.DataTable();
            data{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.addColumn('date', 'Date');
            data{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.addColumn('number', '{{ "Index"|trans }}');
            data{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.addColumn({'type': 'string', 'role': 'tooltip', 'p': {'html': true}});

            var dashboard{{ appareil.Appareil.Numero|replace({'-':'_'}) }} = new google.visualization.Dashboard(document.getElementById('chart_compteur_dashboard{{ appareil.Appareil.Numero|replace({'-':'_'}) }}'));
            controlWrapper{{ appareil.Appareil.Numero|replace({'-':'_'}) }} = new google.visualization.ControlWrapper({
                'controlType': 'DateRangeFilter',
                'containerId': 'chart_compteur_control{{ appareil.Appareil.Numero|replace({'-':'_'}) }}',
                'options': {
                    'filterColumnLabel': 'Date',
                    'ui': {
                        'label': 'Période de consommation affichée',
                        'format': {
                            'pattern': 'dd/MM/y'
                        }
                    }
                }
            });

            var chartWrapper{{ appareil.Appareil.Numero|replace({'-':'_'}) }} = new google.visualization.ChartWrapper({
                'chartType': 'LineChart',
                'containerId': 'chart_compteur_conso{{ appareil.Appareil.Numero|replace({'-':'_'}) }}',
                'options': options
            });

            var series_compteur = '{{ appareil.SerieConsos.ValeursXYL }}';
            var series = series_compteur.split(";");
            for(var i = 0; i < series.length; i++) {
                var serie = series[i].split("|");
                var dateString = serie[0].match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
                date = new Date(dateString[3], dateString[2] - 1, dateString[1]);

                var fuiteNb = null,
                    fuiteStyle = null,
                    fuitetooltip = null;
                if (serie.length > 3 && serie[3].indexOf('FUITE') > -1) {
                    fuiteNb = parseFloat(serie[2].replace(',', '.'));
                    fuiteStyle = 'point { size: 6; shape-type: circle; fill-color: #000000 }';
                    fuitetooltip = customTooltip(('0' + date.getDate()).slice(-2) + ' / ' + ('0' + (date.getMonth() + 1)).slice(-2) + ' / ' + date.getFullYear() + '<br/>Conso: '+serie[1]+'<br/>Index: '+serie[2]);
                }

                data{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.addRow([
                    date, parseFloat(serie[2].replace(',', '.')), customTooltip(('0' + date.getDate()).slice(-2) + ' / ' + ('0' + (date.getMonth() + 1)).slice(-2) + ' / ' + date.getFullYear() + '<br/>Conso: ' + serie[1] + '<br/>Index: ' + serie[2])
                ]);
            }

            dashboard{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.bind(controlWrapper{{ appareil.Appareil.Numero|replace({'-':'_'}) }}, chartWrapper{{ appareil.Appareil.Numero|replace({'-':'_'}) }});
            dashboard{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.draw(data{{ appareil.Appareil.Numero|replace({'-':'_'}) }});

            google.visualization.events.addListener(dashboard{{ appareil.Appareil.Numero|replace({'-':'_'}) }}, 'ready', function () {
                if (!drawn) {
                    {%- if consoTab.EvolutionChartData.chartControl.state.lowValue -%}
                    controlWrapper{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.setState({
                        'lowValue': {{ consoTab.EvolutionChartData.chartControl.state.lowValue }},
                        'highValue': {{ consoTab.EvolutionChartData.chartControl.state.highValue }}
                    });
                    controlWrapper{{ appareil.Appareil.Numero|replace({'-':'_'}) }}.draw();
                    {%- endif -%}
                }
            });

            isCreated{{ appareil.Appareil.Numero|replace({'-':'_'}) }} = true;
            {% endif %}
            {% endfor %}
            {% endif %}
            updateWrapper('{{ consoTab.id }}');

            var v = $('#choosed_compteur{{ consoTab.id }}').val();
            if (v !== undefined && v !== 'all') {
                if (typeof window["controlWrapper" + v] !== "undefined") {
                    var state = eval('controlWrapper' + v + '.getState()'),
                        lowValue = new Date(state.lowValue).getTime(),
                        highValue = new Date(state.highValue).getTime();
                    eval("controlWrapper" + v + ".setState({ lowValue: " + lowValue + ", highValue: " + highValue + " });");
                    $("#chart_compteur_dashboard" + v).show();
                }
            }

            if (enableListener{{ consoTab.id }} === true) {
                enableListener{{ consoTab.id }} = false;

                $('.form-filter{{ consoTab.id }}').submit(function() {

                    updateWrapper('{{ consoTab.id }}');

                    {#if($("input[name='date_from{{ consoTab.id }}']").val().length > 0 || $("input[name='date_to{{ consoTab.id }}']").val().length > 0) {#}
                    {#var timelowval = $('input[name="date_from{{ consoTab.id }}"]').datepicker( "getDate" ).getTime(),#}
                    {#timehighval = $('input[name="date_to{{ consoTab.id }}"]').datepicker( "getDate" ).getTime();#}

                    {#$(".consochart{{ consoTab.id }}").each(function() {#}
                    {#var numero = $(this).attr('data-compteur');#}
                    {#if (numero != "all") {#}
                    {#eval("var result =  isCreated" + numero);#}
                    {#console.log(numero, result);#}
                    {#if(result !== false) {#}
                    {#if (!isNaN(timehighval) && !isNaN(timelowval)) {#}
                    {#eval("controlWrapper" + numero + ".setState({'lowValue': " + timelowval + ", 'highValue': " + timehighval + "})");#}
                    {#} else {#}
                    {#if (!isNaN(timelowval)) {#}
                    {#eval("controlWrapper" + numero + ".setState({'lowValue': " + timelowval + "})");#}
                    {#}#}
                    {#if (!isNaN(timehighval)) {#}
                    {#eval("controlWrapper" + numero + ".setState({'highValue': " + timehighval + "})");#}
                    {#}#}
                    {#}#}
                    {#eval("controlWrapper" + numero + ".draw()");#}
                    {#}#}
                    {#}#}
                    {#});#}
                    {#return false;#}
                    {#if ($("#chart_logement_dashboard{{ consoTab.id }}").is(":visible") == true) {#}
                    {#if (!isNaN(timehighval) && !isNaN(timelowval)) {#}
                    {#controlWrapper.setState({'lowValue': timelowval, 'highValue': timehighval});#}
                    {#} else {#}
                    {#if (!isNaN(timelowval)) {#}
                    {#controlWrapper.setState({'lowValue': timelowval});#}
                    {#}#}
                    {#if (!isNaN(timehighval)) {#}
                    {#controlWrapper.setState({'highValue': timehighval});#}
                    {#}#}
                    {#}#}
                    {#controlWrapper.draw();#}
                    {#}#}
                    {#}#}

                    return false;
                });

                $('#choosed_compteur{{ consoTab.id }}').on('change', function() {
                    var timelowval = $('input[name="date_from{{ consoTab.id }}"]').datepicker("getDate").getTime(),
                        timehighval = $('input[name="date_to{{ consoTab.id }}"]').datepicker("getDate").getTime();

                    $('.charts{{ consoTab.id }}').hide();
                    if (this.value == 'all') {
                        $("#chart_logement_dashboard{{ consoTab.id }}").show();
                        return;
                    }
                    $("#chart_compteur_dashboard" + this.value).show();

                    //eval("dashboard" + this.value + ".draw(data" + this.value + ")");
                    eval("var result =  isCreated" + this.value);

                    if (result !== false) {
                        if ($("input[name='date_from{{ consoTab.id }}']").val().length > 0 || $("input[name='date_to{{ consoTab.id }}']").val().length > 0) {
                            if (!isNaN(timehighval) && !isNaN(timelowval)) {
                                eval("controlWrapper" + this.value + ".setState({'lowValue': " + timelowval + ", 'highValue': " + timehighval + "})");
                            } else {
                                if (!isNaN(timelowval)) {
                                    eval("controlWrapper" + this.value + ".setState({'lowValue': " + timelowval + "})");
                                }
                                if (!isNaN(timehighval)) {
                                    eval("controlWrapper" + this.value + ".setState({'highValue': " + timehighval + "})");
                                }
                            }
                            eval("controlWrapper" + this.value + ".draw()");
                        }
                    } else {
                        $("#chart_compteur_dashboard" + this.value).html("<h2>Le compteur N° " + this.value +" n'a pas enregistré de consommation pour la période définie </h2>");
                    }
                });
            }
        };

        var enableListener{{ consoTab.id }} = true;
        charts['chart_logement_conso{{ consoTab.id }}'] = {
            type: 'function',
            loaded: false,
            func: drawChart{{ consoTab.id }}
        };

        {% if r1repart == 1 or r2repart == 1 %}
        charts['graph_repart_conso'] = {
            type: 'bar',
            loaded: false,
            options: {
                title: '',
                bars: 'horizontal',
                chartArea: {
                    left: 250,
                },
                legend: {
                    position: "bottom",
                    alignment: "end"
                },
                series: [
                    {% if r2repart == 1 %}
                    {
                        color: '#5F6C7C',
                    },
                    {% endif %}
                    {% if r2repart == 1 %}
                    {
                        color: '{{ color }}',
                    },
                    {% endif %}
                ],
                hAxis: {
                    textPosition: 'none',
                    baseline: {
                        color: 'transparent'
                    },
                    gridlines: {
                        color: 'transparent'
                    },
                    minValue: 0
                },
                vAxis: {
                    textPosition: 'left',
                    baseline: {
                        color: 'transparent'
                    },
                    gridlines: {
                        color: '#transparent'
                    }
                },
            },
            datatable: [
                [
                    'Pièce',
                    {% if r2repart == 1 %}
                    '{{ "Unités consommées"|trans }} {{ panel.ConsosPieces.consoPieceRepart is iterable ? panel.ConsosPieces.consoPieceRepart[0].R2.DateReleve|date('Y') : panel.ConsosPieces.consoPieceRepart.R2.DateReleve }}',
                    {role: 'annotation'},
                    {% endif %}
                    {% if r1repart == 1 %}
                    '{{ "Unités consommées"|trans }} {{ panel.ConsosPieces.consoPieceRepart is iterable ? panel.ConsosPieces.consoPieceRepart[0].R1.DateReleve|date('Y') : panel.ConsosPieces.consoPieceRepart.R1.DateReleve }}',
                    {role: 'annotation'},
                    {% endif %}
                ],
                {% if panel.ConsosPieces.consoPieceRepart is iterable %}
                {% for consoPieceRepart in panel.ConsosPieces.consoPieceRepart %}
                [
                    '{{ consoPieceRepart.Emplacement }}',
                    {% if r2repart == 1 %}
                    {{ consoPieceRepart.R2.Conso > 0 ? consoPieceRepart.R2.Conso : 'null' }},
                    {{ consoPieceRepart.R2.Conso > 0 ? consoPieceRepart.R2.Conso : 'null' }},
                    {% endif %}
                    {% if r1repart == 1 %}
                    {{ consoPieceRepart.R1.Conso }},
                    {{ consoPieceRepart.R1.Conso }},
                    {% endif %}
                ],
                {% endfor %}
                {% else %}
                [
                    '{{ panel.ConsosPieces.consoPieceRepart.Emplacement }}',
                    {% if r2repart == 1 %}
                    {{ panel.ConsosPieces.consoPieceRepart.R2.Conso > 0 ? panel.ConsosPieces.consoPieceRepart.R2.Conso : 'null' }},
                    {{ panel.ConsosPieces.consoPieceRepart.R2.Conso > 0 ? panel.ConsosPieces.consoPieceRepart.R2.Conso : 'null' }},
                    {% endif %}
                    {% if r1repart == 1 %}
                    {{ panel.ConsosPieces.consoPieceRepart.R1.Conso }},
                    {{ panel.ConsosPieces.consoPieceRepart.R1.Conso }},
                    {% endif %}
                ],
                {% endif %}
            ],
        };
        {% endif %}

    </script>

</div>
