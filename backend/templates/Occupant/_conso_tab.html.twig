                    <td>
                        {% if ConsoPeriode.R3 is defined and ConsoPeriode.R3.DateReleve|date('d/m/Y') != '01/01/0001' %}
                            {{ ConsoPeriode.R3.Conso }} m<sup>3</sup>
                        {% endif %}
                    </td>
                    <td>
                        {% if ConsoPeriode.R2 is defined and ConsoPeriode.R2.DateReleve|date('d/m/Y') != '01/01/0001' %}
