{% extends '_list_dysfunctions.html.twig' %}

{% block export %}
    <div class="action form btn pull-right" style="padding: 0px;margin: 0px;">
        <a class="submit" href="{{ path('TechemCoreBundle_Occupant_export_dysfunctions') }}" target="_blank"><i class="fa fa-file-excel-o" aria-hidden="true"></i>  {{ "Export Excel"|trans }}</a>
    </div>
{% endblock %}

{% block dysfonctionnements %}
    {% for dysfonctionnement in dysfonctionnements %}
        {% include '_dysfunction.html.twig' with {
            'dysfonctionnement': dysfonctionnement,
            'link': path('TechemCoreBundle_Occupant_show')
        } %}
    {% endfor %}
{% endblock %}