{% extends '_list_interventions.html.twig' %}

{% block export %}
    <div class="action form btn pull-right" style="padding: 0px;margin: 0px;">
        <a class="submit" href="{{ path('TechemCoreBundle_Occupant_export_interventions') }}" target="_blank"><i class="fa fa-file-excel-o" aria-hidden="true"></i>  {{ "Export Excel"|trans }}</a>
    </div>
{% endblock %}

{% block depannages %}
    {% for depannage in depannages %}
        {% include '_intervention.html.twig' with {
            'depannage': depannage,
            'link': path('TechemCoreBundle_Occupant_showintervention', {'pkLogement': logement.Logement.PkLogement, 'pkIntervention': depannage.Depannage.WorkOrderNumber})
        } %}
    {% endfor %}
{% endblock %}