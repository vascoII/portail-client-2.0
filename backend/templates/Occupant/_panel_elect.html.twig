<div class="panel-chart">
    <div class="panel">
        <div class="block-title">Historique des rélevés en KWH sur une année</div>

        <div class="selects">
            <span class="text">Du</span>
            <select name="date" class="charts-select">
                <option>30/07/2015</option>
                <option>30/07/2015</option>
                <option>30/07/2015</option>
            </select>

            <div class="clearfix visible-sm"></div>

            <span class="text">{{ "au"|trans }}</span>
            <select name="date" class="charts-select">
                <option>30/06/2015</option>
                <option>30/06/2015</option>
                <option>30/06/2015</option>
            </select>
        </div>

        <br>
        <!-- chart -->
        <br>

        <div class="clock">
            <div class="block-title">{{ "Relevé de la totalité des compteurs électriques en KWH au 21/07/15"|trans
                }}</div>
            <br>

            <div class="counter">
                <div class="value">
                    <div class="number">0</div>
                    <div class="number">0</div>
                    <div class="number">4</div>
                    <div class="number">8</div>
                    <div class="number">6</div>
                    <div class="number">3</div>
                    <div class="dot">,</div>
                    <div class="number red">4</div>
                </div>

                <span class="text">Kwh</span>
            </div>
        </div>
    </div>
</div>
