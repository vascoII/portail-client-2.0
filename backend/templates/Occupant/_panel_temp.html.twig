                        var timelowval = $('input[name="date_from-hum"]').datepicker( "getDate" ).getTime(),
                            timehighval = $('input[name="date_to-hum"]').datepicker( "getDate" ).getTime();

                        if(!isNaN(timehighval) && !isNaN(timelowval)) {
