<div class="panel">

    {% if consoTab.EvolutionChartData.temp.data|length > 0 %}
        <div class="graph panel-chart">
            <h3>Température du Logement</h3><br><br>
            <div style="width: 100%; height: 80px;">
                <form class="form-filter-temp" name="form-filter" method="post">
                    <p>
                        <label for="date_from">{{ "Du"|trans }}</label>
                        <input id="date_from" type="text" name="date_from-temp" class="datepicker form-control" style="height: 30px;" data-format="dd/mm/yyyy"
                               data-start-date="{% if consoTab.EvolutionChartData.temp.chartControl.state.startDate %}{{ consoTab.EvolutionChartData.temp.chartControl.state.startDate }}{% endif %}"
                               data-end-date="{% if consoTab.EvolutionChartData.temp.chartControl.state.endDate %}{{ consoTab.EvolutionChartData.temp.chartControl.state.endDate }}{% endif %}"
                               value="{% if consoTab.EvolutionChartData.temp.chartControl.state.lowDate %}{{ consoTab.EvolutionChartData.temp.chartControl.state.lowDate }}{% endif %}"/>
                        <i class="fa fa-calendar"></i>
                        <br class="hidden-lg hidden-md hidden-sm"/><br class="hidden-lg hidden-md hidden-sm"/>
                        <label for="date_to">{{ "au"|trans }}</label>
                        <input id="date_to" type="text" name="date_to-temp" class="datepicker form-control" style="height: 30px;" data-format="dd/mm/yyyy"
                               data-start-date="{% if consoTab.EvolutionChartData.temp.chartControl.state.startDate %}{{ consoTab.EvolutionChartData.temp.chartControl.state.startDate }}{% endif %}"
                               data-end-date="{% if consoTab.EvolutionChartData.temp.chartControl.state.endDate %}{{ consoTab.EvolutionChartData.temp.chartControl.state.endDate }}{% endif %}"
                               value="{% if consoTab.EvolutionChartData.temp.chartControl.state.highDate %}{{ consoTab.EvolutionChartData.temp.chartControl.state.highDate }}{% endif %}"/>
                        <i class="fa fa-calendar"></i>
                        <button name="filtreur" id="filtreur" type="submit" class="btn btn-primary">{{ "Filtrer"|trans
                            }}</button>
                    </p>
                </form>
            </div>
            <div id="chart_logement_dashboard_temp">
                <div id="chart_logement_control_temp" class="chart-control" style="display: none;"></div>
                <div id="chart_logement_conso_temp" style="width: 100%; height: 350px;"></div>
            </div>
            {% if panel.IndexRecapTemperature.Date|date('dmY') != '01010001' %}
                <div class="stats" style="margin-left: 50px;">
                    <div class="block-title">Temperature du {{ panel.IndexRecapTemperature.Date|date('d/m/Y') }}</div>
                    <br>
                    <i class="icon icon-temperature"></i><span class="number">{{ panel.IndexRecapTemperature.Moy }} °C </span>
                    <span class="text">T max : <strong>{{ panel.IndexRecapTemperature.Max }}°C</strong> / T min : <strong>{{ panel.IndexRecapTemperature.Min }}°C</strong></span>
                </div>
            {% endif %}
        </div>
        <script type="text/javascript">

            function drawChart_temp() {
                console.log('drawChart_temp');
                var drawn = false;
                var data = new google.visualization.DataTable(),
                    options = {
                        title: '',
                        chartArea: {
                            top: '25'
                        },
                        vAxis: {
                            title: 'en °C'
                        },
                        hAxis: {
                            title: 'Date',
                            format: 'dd/MM/y',
                            viewWindowMode: 'maximized'
                        },
                        series: {
                            0: {
                                color: '#df250c'
                            },
                        },
                        pointSize: 15,
                        legend: {
                            position: "bottom",
                            alignment: "end"
                        },
                        tooltip: {trigger: 'selection', isHtml: true}
                    };

                data.addColumn('date', 'Date');
                data.addColumn('number', 'Température');
                data.addColumn({'type': 'string', 'role': 'tooltip', 'p': {'html': true}});

                {% for chartData in consoTab.EvolutionChartData.temp.data %}
                {% if chartData.index is defined %}
                var date = new Date({{ chartData.label }});
                data.addRow([
                    date,
                    {% if chartData.params is defined and 'NOVISIBLE' in chartData.params %}
                    null, null,
                    {% else %}
                    {{ chartData.index }},
                    customTooltip(('0' + date.getDate()).slice(-2) + ' / ' + ('0' + (date.getMonth() + 1)).slice(-2) + ' / ' + date.getFullYear() + '<br/>Température: {{ chartData.consoRaw }}'),
                    {% endif %}
                ]);
                {% endif %}
                {% endfor %}

                function customTooltip(value) {
                    return '<div style="border-radius:3px;padding:5px;width:90px;background: #717b87;color: #ffffff;text-align: center;position:absolute;left:-45px;bottom:7px;">' + value + '</div>';
                }

                var dashboard = new google.visualization.Dashboard(document.getElementById('chart_logement_dashboard_temp')),
                    controlWrapper = new google.visualization.ControlWrapper({
                        'controlType': 'DateRangeFilter',
                        'containerId': 'chart_logement_control_temp',
                        'options': {
                            'filterColumnLabel': 'Date',
                            'ui': {
                                'label': 'Période de consommation affichée',
                                'format': {
                                    'pattern': 'dd/MM/y'
                                }
                            }
                        }
                    });

                var chartWrapper = new google.visualization.ChartWrapper({
                    'chartType': 'LineChart',
                    'containerId': 'chart_logement_conso_temp',
                    'options': options,
                });

                dashboard.bind(controlWrapper, chartWrapper);
                dashboard.draw(data);


                google.visualization.events.addListener(dashboard, 'ready', function () {
                    if (!drawn) {
                        {%- if consoTab.EvolutionChartData.temp.chartControl.state.lowValue -%}
                        controlWrapper.setState({
                            'lowValue': {{ consoTab.EvolutionChartData.temp.chartControl.state.lowValue }},
                            'highValue': {{ consoTab.EvolutionChartData.temp.chartControl.state.highValue }}
                        });
                        controlWrapper.draw();
                        {%- endif -%}
                        drawn = true;
                    }
                });

                $('.form-filter-temp').submit(function() {
                    if($("input[name='date_from-temp']").val().length > 0 || $("input[name='date_to-temp']").val().length > 0) {
                        var timelowval = $('input[name="date_from-temp"]').datepicker( "getDate" ).getTime(),
                            timehighval = $('input[name="date_to-temp"]').datepicker( "getDate" ).getTime();

                        if(!isNaN(timehighval) && !isNaN(timelowval)) {
                            controlWrapper.setState({'lowValue': timelowval, 'highValue': timehighval});
                        } else {
                            if(!isNaN(timelowval)) {
                                controlWrapper.setState({'lowValue': timelowval});
                            }
                            if(!isNaN(timehighval)) {
                                controlWrapper.setState({'highValue': timehighval});
                            }
                        }
                        controlWrapper.draw();
                    }

                    return false;
                });
            }

            charts['chart_logement_conso_temp'] = {
                type: 'function',
                loaded: false,
                func: drawChart_temp
            };

        </script>
    {% endif %}

    {% if consoTab.EvolutionChartData.hum.data|length > 0 %}
