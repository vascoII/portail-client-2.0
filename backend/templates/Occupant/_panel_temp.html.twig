                               data-end-date="{% if consoTab.EvolutionChartData.hum.chartControl.state.endDate %}{{ consoTab.EvolutionChartData.hum.chartControl.state.endDate }}{% endif %}"
                               value="{% if consoTab.EvolutionChartData.hum.chartControl.state.highDate %}{{ consoTab.EvolutionChartData.hum.chartControl.state.highDate }}{% endif %}"/>
