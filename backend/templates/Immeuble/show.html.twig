{% extends "base.html.twig" %}

{% block body__main_menu %}
    {% include 'Immeuble/_menu.html.twig' %}
{% endblock %}

{% block breadcrumb_mobile %}
    <div class="btn btn-primary btn-lg dropdown-toggle hidden-lg hidden-md" id="dropdownMenu3" data-toggle="dropdown">
        <i class="pull-right icon-arrow"></i>
        <h3>{{ "Immeuble"|trans }} {{ immeuble.Immeuble.Ref }}</h3>
    </div>
    <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu3">
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1"
                   href="{{ path('TechemCoreBundle_Immeuble_index') }}">{{ 'Liste des immeubles'|trans }}</a></h3>
        </li>
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1"
                   href="{{ path('TechemCoreBundle_TableauBordClient_index') }}">{{ 'Le parc'|trans }}</a></h3>
        </li>
    </ul>
{% endblock %}

{% block modal %}
    <div class="form-new-intervention" style="display: none;">
        <div class="content-form">
            <div class="cross-close">
                <img src="{{ asset('bundles/techemcore/images/fidesio/cross.svg') }}"/>
            </div>
            <h4>Livret d'intervention</h4>
            <form class="livret-intervention"
                  action="{{ path('TechemCoreBundle_Immeuble_intervention', {
                      'pkImmeuble' : immeuble.Immeuble.PkImmeuble
                  }) }}" target="_blank">
                <div class="content-date">
                    <div class="begin">
                        Du
                        <div class="input-group date" data-provide="datepicker">
                            <input class="datepicker" type="text" class="form-control" name="date-begin">
                            <div class="input-group-addon"></div>
                        </div>
                    </div>
                    <div class="end">
                        Au
                        <div class="input-group date" data-provide="datepicker">
                            <input  class="datepicker" type="text" class="form-control" name="date-end">
                            <div class="input-group-addon"></div>
                        </div>
                    </div>
                </div>
                <div class="alert alert-warning warning" style="display: none">
                    Vous devez remplir les deux champs dates
                </div>
                <input type="hidden" name="doc-type" id="doc-type">
                <input type="submit" value="Synthèse des interventions" name="synthese-inte" id="synthese-inte">
                <input type="submit" value="Détail des interventions" name="detail-inte" id="detail-inte">
                <input type="submit" value="Détail des interventions" name="detail-excel-inte" id="detail-excel-inte">
            </form>
        </div>
        <div class="back-close"></div>
    </div>
{% endblock %}

{% block main_content %}

    <script type="text/javascript">
        var charts = Array();
    </script>
    <ul class="breadcrumb hidden-xs">
        <li><a href="{{ path('TechemCoreBundle_TableauBordClient_index') }}">{{ 'Le parc'|trans }}</a></li>
        <li><a href="{{ path('TechemCoreBundle_Immeuble_index') }}">{{ 'Liste des immeubles'|trans }}</a></li>
        <li><a href="#">{{ "Immeuble"|trans }} {{ immeuble.Immeuble.Ref }}</a></li>
    </ul>
    <span class="clearfix"></span>
    <h2>{{ "Aperçu de l'immeuble"|trans }} {{ immeuble.Immeuble.Ref }}</h2>

    <div class="row panel-area building-detail-area">

        <div class="col-md-8 col-sm-6 block block-1">
            <div class="panel panel-primary parc_summary panel-info">

                <div class="meta clearfix">
                    
					<div class="icons">
                        <i class="icon-immeuble"></i>
                    </div>


					<div class="col-md-5 ">
						<div class="data">
							{% if immeuble.Immeuble.Nom %}
								<p><strong>{{ "Nom" |trans }} : <span>{{ immeuble.Immeuble.Nom }}</span></strong></p>
							{% endif %}
							<p><strong>{{ 'Référence'|trans }} : <span>{{ immeuble.Immeuble.Ref }}</span></strong></p>
							<p><strong>{{ "N° d'immeuble"|trans }} : <span>{{ immeuble.Immeuble.Numero }} </span></strong>
							</p>
							<br/>
							<p class="address">{{ immeuble.Immeuble.Adresse1 }} {{ immeuble.Immeuble.Adresse2 }} {{ immeuble.Immeuble.Adresse3 }}</p>
							<p class="address">{{ immeuble.Immeuble.Cp }} {{ immeuble.Immeuble.Ville }}</p>

							<a href="{{ path('TechemCoreBundle_Logement_index', { pkImmeuble: immeuble.Immeuble.PkImmeuble }) }}"
							   class="button">
								<strong>{{ immeuble.NbLogements }}</strong> {{ "Logements"|trans }} <i
										class="icon icon-opened33"></i> <i class="fa fa-chevron-right"></i>
							</a>
						</div>
					{% if demo is defined %}
						<div class="col-md-6 ">
							<div id="map"></div>
						</div>
						
						<div class="clearfix">
					{% endif %}
				</div>
					
					
{% if demo is defined %}

