<div class="panel panel-body status-gaugeb {{ classes }} {% if value != 0 %}on{% else %}off{% endif %}">
    <a href="{% if link is defined %}{{ link }}{% else %}#{% endif %}">
        <div class="panel-default">
            <div class="panel-body">
                <div class="taux">{{ value }}</div>
                <div class="canvas">
                    <div class="picto"></div>
                </div>
                <div class="intitule"><span>{{ label|raw }}</span></div>
            </div>
        </div>
    </a>
</div>