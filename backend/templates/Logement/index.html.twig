{% extends "base.html.twig" %}

{% block body__main_menu %}
    {% include 'Immeuble/_menu.html.twig' %}
{% endblock %}

{% block breadcrumb_mobile %}
    <div class="btn btn-primary btn-lg dropdown-toggle hidden-lg hidden-md" id="dropdownMenu3" data-toggle="dropdown">
        <i class="pull-right icon-arrow"></i>
        <h3>{{ "Liste des logements"|trans }}</h3>
    </div>
    <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu3">
        <li role="presentation">
            <h3>
                <a role="menuitem" tabindex="-1"
                   href="{{ path('TechemCoreBundle_Immeuble_show', {'pkImmeuble': immeuble.Immeuble.PkImmeuble}) }}">{{ "Immeuble"|trans }} {{ immeuble.Immeuble.Ref }}</a>
            </h3>
        </li>
        <li role="presentation">
            <h3>
                <a role="menuitem" tabindex="-1"
                   href="{{ path('TechemCoreBundle_Immeuble_index') }}">{{ 'Liste des immeubles'|trans }}</a>
            </h3>
        </li>
        <li role="presentation">
            <h3>
                <a role="menuitem" tabindex="-1"
                   href="{{ path('TechemCoreBundle_TableauBordClient_index') }}">{{ 'Le parc'|trans }}</a>
            </h3>
        </li>
    </ul>
{% endblock %}

{% block modal %}
    {% include 'Ticketing/form-ticket-attachment.html.twig' %}
{% endblock %}

{% block main_content %}
    <ul class="breadcrumb hidden-xs">
        <li><a href="{{ path('TechemCoreBundle_TableauBordClient_index') }}">{{ 'Le parc'|trans }}</a></li>
        <li><a href="{{ path('TechemCoreBundle_Immeuble_index') }}">{{ 'Liste des immeubles'|trans }}</a></li>
        <li>
            <a href="{{ path('TechemCoreBundle_Immeuble_show', {'pkImmeuble': immeuble.Immeuble.PkImmeuble}) }}">{{ "Immeuble"|trans }} {{ immeuble.Immeuble.Ref }}</a>
        </li>
        <li><a href="#">{{ "Liste des logements"|trans }}</a></li>
    </ul>
    <span class="clearfix"></span>
    {{ render(controller('App\\Controller\\LogementController::filterResultAction', app.request.query.all|merge({'pkImmeuble': immeuble.Immeuble.PkImmeuble, 'gestion': gestion}))) }}
{% endblock %}

{% block body_classes %}{{ parent() }} listhousing{% endblock %}