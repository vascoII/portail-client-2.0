{% extends "base.html.twig" %}

{% block body__main_menu %}
    {% include 'Logement/_menu.html.twig' with {'active': 'dep'} %}
{% endblock %}

{% block breadcrumb_mobile %}
    <div class="btn btn-primary btn-lg dropdown-toggle hidden-lg hidden-md" id="dropdownMenu3" data-toggle="dropdown">
        <i class="pull-right icon-arrow"></i>
        <h3>Dépannage {{ depannage.InfosDepannage.Depannage.Numero }}</h3>
    </div>
    <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu3">
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_Logement_listinterventions', { 'pkLogement': logement.Logement.PkLogement }) }}">{{ "Dépannages en cours"|trans }}</a></h3>
        </li>
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_Logement_show', { 'pkLogement': logement.Logement.PkLogement }) }}">{{ "Logement" }} {{ logement.Occupant.Ref }}</a></h3>
        </li>
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_Logement_index', { 'pkImmeuble': logement.Immeuble.PkImmeuble }) }}">{{ "Liste des logements"|trans }}</a></h3>
        </li>
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_Immeuble_show', { 'pkImmeuble': logement.Immeuble.PkImmeuble }) }}">{{ "Immeuble" }} {{ logement.Immeuble.Ref }}</a></h3>
        </li>
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_Immeuble_index') }}">{{ 'Liste des immeubles'|trans }}</a></h3>
        </li>
        <li role="presentation">
            <h3><a role="menuitem" tabindex="-1" href="{{ path('TechemCoreBundle_TableauBordClient_index') }}">{{ 'Le parc'|trans }}</a></h3>
        </li>
    </ul>
{% endblock %}

{% block main_content %}
    <ul class="breadcrumb hidden-xs">
        <li><a href="{{ path('TechemCoreBundle_TableauBordClient_index') }}">{{ 'Le parc'|trans }}</a></li>
        <li><a href="{{ path('TechemCoreBundle_Immeuble_index') }}">{{ 'Liste des immeubles'|trans }}</a></li>
        <li><a href="{{ path('TechemCoreBundle_Immeuble_show', { pkImmeuble: logement.Immeuble.PkImmeuble }) }}">{{ "Immeuble"|trans }} {{ logement.Immeuble.Ref }}</a></li>
        <li><a href="{{ path('TechemCoreBundle_Logement_index', { pkImmeuble: logement.Immeuble.PkImmeuble }) }}">{{ "Liste des logements"|trans }}</a></li>
        <li><a href="{{ path('TechemCoreBundle_Logement_show', { 'pkLogement': logement.Logement.PkLogement }) }}">{{
                "Logement"|trans }}
                {{ logement.Occupant.Ref }}</a></li>
        <li><a href="{{ path('TechemCoreBundle_Logement_listinterventions', { 'pkLogement': logement.Logement.PkLogement }) }}">{{ "Dépannages en cours"|trans }}</a></li>
        <li><a href="#">{{ "Dépannage"|trans }} {{ depannage.InfosDepannage.Depannage.Numero }}</a></li>
    </ul>
    <span class="clearfix"></span>

    {% include '_show_intervention.html.twig' %}
{% endblock %}

{% block body_classes %}{{ parent() }}{% endblock %}