{% if immeuble is defined %}
    <div class="title-area">
        <strong>{{ "Immeuble"|trans }} {{ immeuble.Immeuble.Numero }}</strong> {{ immeuble.Immeuble.Adresse1 }} {{ immeuble.Immeuble.Cp }} {{ immeuble.Immeuble.Ville }}
    </div>

{% endif %}
{% if not gestion %}
    <div class="row filters">
        <div class="clearfix"></div>
        <h3>{{ "Filtré par"|trans }} : </h3>

        <div class="clearfix"></div>

        <form role="form" class="form-horizontal filters">
            <div class="form-group">
                <div class="col-md-3 col-sm-6 select-input">
                    <div class="select-replace">
                        <select id="EnergieSelect">
                            <option value="">{{ "Toutes les énergies"|trans }}</option>
                            <option value="energieef" {% if app.request.get('energieef') == 1 %} selected{% endif %}>{{ "Eau froide"|trans }}</option>
                            <option value="energieec" {% if app.request.get('energieec') == 1 %} selected{% endif %}>{{ 'Eau chaude'|trans }}</option>
                            <option value="energierepart" {% if app.request.get('energierepart') == 1 %} selected{% endif %}>{{ 'Répartiteur'|trans }}</option>
                            <option value="energiecet" {% if app.request.get('energiecet') == 1 %} selected{% endif %}>{{ "Compteur d'énergie thermique"|trans }}</option>
                            <option value="energieelect" {% if app.request.get('energieelect') == 1 %} selected{% endif %}>{{ "Electricité"|trans }}</option>
                            <option value="energiegaz" {% if app.request.get('energiegaz') == 1 %} selected{% endif %}>{{ "Gaz"|trans }}</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="checkbox checkbox-replace" style="display:inline-block">
                        <input name="fuites" type="checkbox" {% if app.request.get('fuites') == 1 %}checked{% endif %}>
                        <label>{{ "Fuites"|trans }}</label>
                    </div>
                    <div class="clearfix"></div>
                    <div class="checkbox checkbox-replace" style="display:inline-block">
                        <input name="anomalies" type="checkbox"
                            {% if app.request.get('anomalies') == 1 %}checked{% endif %}>
                        <label>{{ "Anomalies"|trans }}</label>
                    </div>
                    <div class="clearfix"></div>
                    <div class="checkbox checkbox-replace" style="display:inline-block">
                        <input name="dysfonctionnements" type="checkbox"
                            {% if app.request.get('dysfonctionnements') == 1 %}checked{% endif %}>
                        <label>{{ "Alarmes techniques"|trans }}</label>
                    </div>
                    <div class="clearfix"></div>
                    <div class="checkbox checkbox-replace" style="display:inline-block">
                        <input name="depannages" type="checkbox"
                            {% if app.request.get('depannages') == 1 %}checked{% endif %}>
                        <label>{{ "Dépannages en cours"|trans }}</label>
                    </div>
                </div>

                <div class="clearfix visible-xs"></div>
                <div class="col-md-6 text-input">
                    <div class="form-group">
                        <div class="col-sm-6">
                            <input type="text" name="reference" class="form-control"
                                placeholder={{ "Référence / Numéro"|trans }}>
                        </div>
                        <div class="col-sm-6">
                            <input type="text" name="location" class="form-control"
                                placeholder="{{ "Code postal / Ville"|trans }}">
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
{% endif %}


<div class="row filters buttons">
    <div class="dropdown button-wrapper col-xs-4" data-filter-name="batiment">
        <button class="btn btn-primary btn-lg dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown">
            <span class="caret"></span>
            <span class="hidden-xs">{{ "Batiment"|trans }}</span>
            <span class="value"></span>
            <i class="icon-batiment"></i>
        </button>
        <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu1">
            <li role="presentation"><a role="menuitem" tabindex="-1" href="#" data-value="">{{ "Aucun"|trans }}</a></li>
            {% for batiment in filters.batiment %}
                <li role="presentation">
                    <a role="menuitem" tabindex="-1" href="#"
                       data-value="{{ batiment }}">{{ "Batiment"|trans }} {{ batiment }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="dropdown button-wrapper col-xs-4" data-filter-name="escalier">
        <button class="btn btn-primary btn-lg dropdown-toggle" type="button" id="dropdownMenu2" data-toggle="dropdown">
            <span class="caret"></span>
            <span class="hidden-xs">{{ "Escalier"|trans }}</span>
            <span class="value"></span>
            <i class="icon-escalier"></i>
        </button>
        <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu2">
            <li role="presentation"><a role="menuitem" tabindex="-1" href="#" data-value="">{{ "Aucun"|trans }}</a></li>
            {% for escalier in filters.escalier %}
                <li role="presentation">
                    <a role="menuitem" tabindex="-1" href="#"
                       data-value="{{ escalier }}">{{ "Escalier"|trans }} {{ escalier }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="dropdown button-wrapper col-xs-4" data-filter-name="etage">
        <button class="btn btn-primary btn-lg dropdown-toggle" type="button" id="dropdownMenu3" data-toggle="dropdown">
            <span class="caret"></span>
            <span class="hidden-xs">{{ "Etage"|trans }}</span>
            <span class="value"></span>
            <i class="icon-etage"></i>
        </button>
        <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu3">
            <li role="presentation"><a role="menuitem" tabindex="-1" href="#" data-value="">{{ "Aucun"|trans }}</a></li>
            {% for etage in filters.etage %}
                <li role="presentation">
                    <a role="menuitem" tabindex="-1" href="#"
                       data-value="{{ etage }}">{{ "Etage"|trans }} {{ etage }}</a></li>
            {% endfor %}
        </ul>
    </div>
    {% if not gestion and immeuble is defined  %}
        <div class="dropdown button-wrapper col-xs-4 pull-right action form">
            <a class="submit"
            href="{{ path('TechemCoreBundle_Logement_export', {'pkImmeuble': immeuble.Immeuble.PkImmeuble}) }}"
            target="_blank"><i class="fa fa-file-excel-o" aria-hidden="true"></i> {{ "Export Excel"|trans }}
            </a>
        </div>
    {% endif %}
</div>

