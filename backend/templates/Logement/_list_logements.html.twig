<script type="text/javascript" src="{{ asset('bundles/techemcore/js/jquery.validate.min.js') }}"></script>
<script>
    // validate file extension and filesize
    const fileInput = document.getElementById('intervention_attachment')

    fileInput.addEventListener('change', (event) => {
        const target = event.target
        if (target.files && target.files[0]) {
            var attachmentError = document.getElementById('attachment_error');
            attachmentError.innerHTML = '';
            /* maximum allowed size 2 MB  */
            const maxAllowedSize = 2 * 1024 * 1024;
            var allowedExtensions =  /(\.jpg|\.gif|\.png|\.docx|\.pdf|\.xlsx)$/i;
            var filePath = fileInput.value;

            if (target.files[0].size > maxAllowedSize || !allowedExtensions.exec(filePath)) {

                target.value = ''
                attachmentError.innerHTML = ' Format de fichier non valide ou le fichier dépasse la taille maximale';

            }

        }
    })
</script>
<script type="text/javascript">
    $(
        function () {
            var mapping_text = {
                'reference' : ['reference', 'numero'],
                'batiment' : ['batiment'],
                'escalier' : ['escalier'],
                'etage' : ['etage']
            };

            // Affichage popup demande d'intervention

            $('.form-new-intervention .cross-close, .form-new-intervention .back-close').click(
                function () {
                    $('.form-new-intervention').fadeOut();
                }
            );

            $('.btn-new-intervention').click(
                function () {

                    var pkLogement = $(this).closest('li').attr('data-pklogement');
                    console.log(pkLogement);
                    var data = 'pkLogement=' + pkLogement;

                    $.ajax(
                        {
                            type : "POST",
                            data : { pkLogement : pkLogement },
                            url : window.location.pathname + '/ticketowner',
                            success : function (data)
                            {
                                $('.form-new-intervention #intervention_pkLogement').val(pkLogement);
                                $('.form-new-intervention #intervention_name').val(data.Nom);
                                $('.form-new-intervention #intervention_email').val(data.Email);
                                $('.form-new-intervention #intervention_phone').val(data.TelFixe);
                                $('.form-new-intervention #intervention_mobile').val(data.TelMobile);
                            },
                            error : function (err) {
                                console.log('err');
                                console.log(err);
                            }
                        }
                    );
                }
            );

            $('.btn-new-intervention').click(
                function () {
                    $('.form-new-intervention').fadeIn();
                }
            );

            // validation rules

            $('.form-new-intervention form[name=intervention]').validate({
                rules: {
                    intervention_name: {
                        required: true,
                        minlength: 2
                    },
                    intervention_email: {
                        required: false,
                        minlength: 5,
                        email: true
                    },
                    intervention_phone: {
                        require_from_group: [1, ".phone-group"]
                    },
                    intervention_mobile: {
                        require_from_group: [1, ".phone-group"]
                    },
                    intervention_objet: {
                        required: true,
                        minlength: 5
                    },
                    intervention_message: {
                        required: true,
                        minlength: 5
                    },
                    intervention_attachment: {
                        required: false
                    }
                },
                messages: {
                    intervention_name: { required: "veuillez insérer votre nom"},
                    intervention_email: { required: "veuillez insérer une adresse mail valide"},
                    intervention_phone: { required: "veuillez insérer un numéro de téléphone"},
                    intervention_mobile: { required: "veuillez insérer un numéro de portable"},
                    intervention_objet: { required: "veuillez remplir ce champ"},
                    intervention_message: { required: "veuillez remplir ce champ"},
                    intervention_attachment: { extension: "extensions acceptés: docx|xlsx|pdf|png|jpg|gif"}
                },

            });

            // Crée une demande d'intervention

            $('.form-new-intervention form[name=intervention]').submit(
                function (e) {
                    e.preventDefault();
                    if ($('#intervention_phone').val().length > 2 || $('#intervention_mobile').val().length > 2) {

                        var form = document.getElementById("interventionForm");

                        $.ajax(
                            {
                                type : "POST",
                                data : new FormData(form),
                                url : $(this).attr('action'),
                                processData: false,
                                contentType: false,
                                cache: false,
                                success : function (data)
                                {
                                    $('li[data-pkLogement=' + data.pkLogement + '] .tickets-inprogress').show();
                                    $('li[data-pkLogement=' + data.pkLogement + '] .tickets-number').text(data.nbTickets);
                                    $('.form-new-intervention').fadeOut();
                                    $('.form-new-intervention form').find("input[type=text], textarea").val('');
                                    $('.confirm-new-intervention').fadeIn().delay(800).fadeOut();
                                },
                                error : function (data) {
                                    console.log(data);
                                }
                            }
                        );
                    }
                }
            );


            $('.listhousing .filters input[type=checkbox]').on(
                'change', function () {
                    $('.listhousing form.filters').trigger('data-change');
                }
            );

            $('.listhousing .filters select').on(
                'change', function () {
                    $('.listhousing .filters').trigger('data-change');
                }
            );

            $('.listhousing .filters input[type=text]').on(
                'keyup', function () {
                    $('.listhousing form.filters').trigger('data-change');
                }
            );

            $('.listhousing .filters .dropdown.button-wrapper a[role=menuitem]').click(
                function (e) {
                    e.preventDefault();
                    $(this).closest('.dropdown.button-wrapper').find('.value').text($(this).attr('data-value'));
                    $('.listhousing form.filters').trigger('data-change');
                }
            );

            $('.listhousing form.filters').on(
                'data-change', function () {
                    $('.loader').trigger('start');
                    var $items = $('.listhousing .housing-area li'),
                        $filtered_items = $items,
                        boolean_data = $('.listhousing .filters input[type=checkbox]').serializeArray(),
                        text_data = $('.listhousing .filters input[type=text]').serializeArray(),
                        $button_filter = $('.listhousing .filters .dropdown.button-wrapper[data-filter-name]'),
                        exact_text_data = [];

                    var select_var = $('.listhousing .filters select').val()
                    if (select_var != undefined && select_var != "") {
                        boolean_data.push(
                            {
                                name : select_var,
                                value : 'on'
                            }
                        );
                    }

                    $button_filter.each(
                        function () {
                            exact_text_data.push(
                                {
                                    'name' : $(this).attr('data-filter-name'),
                                    'value' : $(this).find('.value').text()
                                }
                            );
                        }
                    );

                    $.each(
                        boolean_data, function (key, filter) {
                            $filtered_items = $filtered_items.filter(
                                function () {
                                    return $(this).data(filter.name) === 'O';
                                }
                            );
                        }
                    );

                    $.each(
                        text_data, function (key, filter) {
                            $filtered_items = $filtered_items.filter(
                                function () {
                                    var me = $(this),
                                        test;

                                    if (mapping_text.hasOwnProperty(filter.name) && filter.value != '') {
                                        test = false;
                                        $.each(
                                            mapping_text[filter.name], function (key, name) {
                                                test |= me.attr('data-' + name).toLowerCase().indexOf(filter.value.toLowerCase()) === 0; // .data() try to convert values
                                            }
                                        );

                                    } else {
                                        test = true;
                                    }

                                    return test;
                                }
                            );
                        }
                    );

                    $.each(
                        exact_text_data, function (key, filter) {
                            $filtered_items = $filtered_items.filter(
                                function () {
                                    var me = $(this),
                                        test;

                                    if (mapping_text.hasOwnProperty(filter.name) && filter.value != '') {
                                        test = false;
                                        $.each(
                                            mapping_text[filter.name], function (key, name) {
                                                test |= me.attr('data-' + name).toLowerCase() === filter.value.toLowerCase();
                                            }
                                        );
                                    } else {
                                        test = true;
                                    }

                                    return test;
                                }
                            );
                        }
                    );

                    $items.addClass('hidden');
                    $filtered_items.toggleClass('hidden');
                    $('.listhousing .result-length').text($filtered_items.length);
                    $('.loader').trigger('stop');
                }
            );

            // Logement infos appareils
            $('.listhousing .housing-area .toggle-details').click(
                function () {
                    var $me = $(this),
                        $parent = $me.closest('li'),
                        $infosAppareils = $($(this).data('target'), $parent);


                    if (!$infosAppareils.hasClass('loaded')) {
                        $.ajax(
                            {
                                url : '{{ path('TechemCoreBundle_Logement_infos_appareils') }}',
                                data : {
                                    'pklogement' : $parent.attr('data-pklogement'),
                                    'type' : $me.attr('data-type')
                                },
                                method : 'get',
                                dataType : 'html',
                                success : function (html) {
                                    $infosAppareils.addClass('loaded');
                                    $infosAppareils.html(html);
                                }
                            }
                        );
                    }
                }
            );
        }
    );
</script>
