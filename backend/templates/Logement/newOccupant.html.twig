												{% if occupant.newCodeLogeGestio is defined %}
													value="{{ occupant.newCodeLogeGestio }}" 
												{% endif%}
												>
                                                <span class="error-message">Veuillez saisir un numéro de logement.</span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-xs-2"><i class="pull-right fa fa-file"></i></label>
                                            <div class="controls col-xs-10 buttonIn">
                                                <input type="text" class="form-control" placeholder="Saisir un numéro de Bail" name="numBail" data-field="numBail" 
												{% if occupant.newNumBail is defined %}
													value="{{ occupant.newNumBail }}" 
												{% endif%}
												>
                                                <span class="error-message">Veuillez saisir un numéro de Bail valide.</span>
                                            </div>
                                        </div>
                                        <div class="form-group">Date d'arrivée
                                            <label class="col-xs-2"><i class="pull-right fa fa-calendar"></i></label>
                                            <div class="controls col-xs-10 buttonIn">
                                                <input type="date" class="form-control" placeholder="Enter the move-in date" name="dateArrivee" data-field="dateArrivee" id="dateArrivee"
												
												{% if occupant.newDateArrivee is defined %}
													value="{{ occupant.newDateArrivee }}" 
												{% endif%}

												>
                                            </div>
                                        </div>
                                        <div style="text-align: center;">
                                            <button type="submit" style="padding: 5px; width: 80%; background: white; color: black; border: 1px solid black;" class="btn btn-primary submit-occupant">{{ "Valider"|trans }}</button>
                                        </div>

                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="app">
                    <div class="inner"><strong>{{ logement.NbAppareils }}</strong> {{ "Appareils"|trans }}</div>
                </div>

                <div class="stats clearfix">
                    {% if logement.NbCompteursEF != -1 %}
                        <div class="item">
                            <div class="value">{{ logement.NbCompteursEF }}</div>

                            <div class="title">{{ "Eau froide"|trans }}</div>
                        </div>
                    {% endif %}

                    {% if logement.NbCompteursEC != -1 %}
                        <div class="item">
                            <div class="value">{{ logement.NbCompteursEC }}</div>

                            <div class="title">{{ 'Eau chaude'|trans }}</div>
                        </div>
                    {% endif %}

                    {% if logement.NbCompteursRepart != -1 %}
                        <div class="item">
                            <div class="value">{{ logement.NbCompteursRepart }}</div>

                            <div class="title">{{ 'Répartiteurs'|trans }}</div>
                        </div>
                    {% endif %}

                    {% if logement.NbCompteursCET != -1 %}
                        <div class="item">
                            <div class="value">{{ logement.NbCompteursCET }}</div>

                            <div class="title">{{ "Compteur d'énergie"|trans }}</div>
                        </div>
                    {% endif %}

                    {% if logement.NbCompteursElect != -1 %}
                        <div class="item">
                            <div class="value">{{ logement.NbCompteursElect }}</div>

                            <div class="title">{{ "Electricité"|trans }}</div>
                        </div>
                    {% endif %}

                    {% if logement.NbCompteursGaz != -1 %}
                        <div class="item">
                            <div class="value">{{ logement.NbCompteursGaz }}</div>

                            <div class="title">{{ "Gaz"|trans }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
