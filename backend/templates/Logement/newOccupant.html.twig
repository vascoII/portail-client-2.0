                                                <span class="error-message">Veuillez saisir le nom de l'occupant.</span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-xs-2"><i class="pull-right fa fa-envelope"></i></label>
                                            <div class="controls col-xs-10 buttonIn">
                                                <input type="email" class="form-control" placeholder="Saisir une adresse mail" name="email" data-field="email"
												{% if occupant.newEmail is defined %}
													value="{{ occupant.newEmail }}" 
												{% endif%}>
                                                <span class="error-message">Veuillez saisir une adresse email valide.</span>
                                            </div>
                                        </div>
                                        <div class="form-group">
