                        <div class="col-sm-6">
                            <h4>
                                {{ "Occupant actuel"|trans }}
                            </h4>
                            <div class="info clearfix" style="margin-bottom: 14%;">
                                <div class="icons">
                                    <i class="icon-user"></i>
                                </div>
                                <strong>{{ 'Occupant'|trans }} : <span>{{ logement.Occupant.Nom }}</span></strong>

{#                                <p>#}
{#                                    <strong>{{ "Date de départ"|trans }} <span style="color: red;">*</span>:<span>{{ logement.Occupant.DateArrivee|date("d/m/Y") }}</span></strong>#}
{#                                </p>#}
