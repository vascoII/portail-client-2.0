{% endblock %}

{% block body_classes %}{{ parent() }} logement{% endblock %}

{% block javascripts_foot %}
    {{ parent() }}
    <script type="text/javascript" src="https://www.google.com/jsapi"></script>
    <script type="text/javascript" src="http://www.chartjs.org/assets/Chart.min.js"></script>
    <script type="text/javascript" src="{{ asset('bundles/techemcore/js/custom/status-gauge.js') }}"></script>
    <script type="text/javascript" src="{{ asset('bundles/techemcore/js/custom/performance-gauge.js') }}"></script>
    <script type="text/javascript" src="{{ asset('bundles/techemcore/js/custom/charts.js') }}"></script>
    <script type="text/javascript" src="{{ asset('bundles/techemcore/js/jquery.validate.min.js') }}"></script>



    <script>

        $(document).ready(function() {

            var submit = $(".submit-occupant");
            var inputFields = $(".input-group input");
            inputFields.on('input', function () {
                checkInputValues();
            });
            function checkInputValues() {
                var allInputsValid = true;

                inputFields.each(function () {
                    var input = $(this);
                    var errorSpan = input.siblings('.error-message');
                    if (!input[0].checkValidity()) {
                        allInputsValid = false;
                        errorSpan.show();
                    } else {
                        errorSpan.hide();
                    }
                });

                submit.prop("disabled", !allInputsValid);
            }


            $(".edit-icon").click(function() {
                var input = $(this).siblings("input");
                var editIcon = $(this);
                var checkIcon = $(this).siblings(".fa-check");

            });

            $(".fa-check").click(function() {
                var editIcon = $(this).siblings(".fa-pencil");
                var input = $(this).siblings("input");

                // Disable editing
                input.removeClass("input-enabled").addClass("input-disabled");
                input.prop("disabled", true);
                $(this).addClass("hidden");
                editIcon.removeClass("hidden");
            });

            $(".submit-occupant").click(function(e) {
                e.preventDefault();
                var formData = {
                    email: $("input[name='email']").val(),
                    phone: $("input[name='phone']").val(),
                    numbail: $("input[name='numBail']").val(),
                    dateArrivee: $("input[name='dateArrivee']").val(),
                    name: $("input[name='nameOccupant']").val()
                };

                var url = "{{ path('TechemCoreBundle_GestionParc_show', {'pkLogement': pkLogement}) }}";
                $.ajax({
                    type: "POST",
                    url: url,
                    data: JSON.stringify(formData),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function(response) {
                        alert('Informations sauvegardées')
                        window.history.go(-1);
                    },
                    error: function(xhr, status, error) {
                        console.log(error);
                    }

                });
            });
            // validate file extension and filesize
            const fileInput = document.getElementById('intervention_attachment')

            fileInput.addEventListener('change', (event) => {
                const target = event.target
                if (target.files && target.files[0]) {
                    var attachmentError = document.getElementById('attachment_error');
                    attachmentError.innerHTML = '';
                    /* maximum allowed size 2 MB  */
                    const maxAllowedSize = 2 * 1024 * 1024;
                    var allowedExtensions =  /(\.jpg|\.gif|\.png|\.docx|\.pdf|\.xlsx)$/i;
                    var filePath = fileInput.value;

                    if (target.files[0].size > maxAllowedSize || !allowedExtensions.exec(filePath)) {

                        target.value = ''
                        attachmentError.innerHTML = ' Format de fichier non valide ou le fichier dépasse la taille maximale';

                    }

                }
            })
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var today = new Date();
            var formattedDate = today.toISOString().substr(0, 10);
            document.getElementById("dateArrivee").value = formattedDate;
        });
    </script>

    <script type="text/javascript">
        (function () {

            // Affichage popup demande d'intervention

            $('.form-new-intervention .cross-close, .form-new-intervention .back-close').click(
                function () {
                    $('.form-new-intervention').fadeOut();

                }
            );
            $('.btn-new-intervention').click(
                function () {
                    $('.form-new-intervention').fadeIn();
                }
            );
            // validation rules

            $('.form-new-intervention form[name=intervention]').validate({
                rules: {
                    intervention_name: {
                        required: true,
                        minlength: 2
                    },
                    intervention_email: {
                        required: false,
                        minlength: 5,
                        email: true
                    },
                    intervention_phone: {
                        require_from_group: [1, ".phone-group"]
                    },
                    intervention_mobile: {
                        require_from_group: [1, ".phone-group"]
                    },
                    intervention_objet: {
                        required: true,
                        minlength: 5
                    },
                    intervention_message: {
                        required: true,
                        minlength: 5
                    },
                    intervention_attachment: {
                        required: false
                    }
                },
                messages: {
                    intervention_name: { required: "veuillez insérer votre nom"},
                    intervention_email: { required: "veuillez insérer une adresse mail valide"},
                    intervention_phone: { required: "veuillez insérer un numéro de téléphone"},
                    intervention_mobile: { required: "veuillez insérer un numéro de portable"},
                    intervention_objet: { required: "veuillez remplir ce champ"},
                    intervention_message: { required: "veuillez remplir ce champ"},
                    intervention_attachment: { extension: "extensions acceptés: docx|xlsx|pdf|png|jpg|gif"}
                },

            });

            //end validation rules

            // call ajax send form

            $('.form-new-intervention form[name=intervention]').submit(
                function (e) {
                    e.preventDefault();
                    if ($('#intervention_phone').val().length > 2 || $('#intervention_mobile').val().length > 2) {

                        var form = document.getElementById("interventionForm");

                        console.log($(this).attr('action'));

                        $.ajax(
                            {
                                type : "POST",
                                data : new FormData(form),
                                url : $(this).attr('action'),
                                processData: false,
                                contentType: false,
                                cache: false,
                                success : function (data)
                                {
                                    $('.tickets-inprogress').show();
                                    $('.tickets-number').text(data.nbTickets);
                                    $('.form-new-intervention').fadeOut();
                                    $('.form-new-intervention form').find("input[type=text], textarea").val('');
                                    $('.confirm-new-intervention').fadeIn().delay(600).fadeOut();
                                },
                                error : function (data) {
                                    console.log(data);
                                }
                            }
                        );
                    }
                }
            );

            // end call ajax

            $('a[data-toggle="tab"]').on(
                'shown.bs.tab', function (e) {
                    var $me = $(e.target);
                    var $area = $($me.attr('href'));

                    drawGauge($area.attr('data-area'));
                    drawCharts($area.attr('data-area'));
                }
            )

            var defaultArea = $('.tab-detail-area > .tab-content > .tab-pane.active').attr('data-area');
            drawGauge(defaultArea);
            drawCharts(defaultArea);

        })();
    </script>
    <script>
        jQuery.extend(jQuery.validator.messages, {
            required: "Veuillez remplir ce champ",
            email: "Veuillez insérer une adresse mail valide",
            accept: "Veuillez saisir un fichier avec une extension valide",

        });</script>


{% endblock %}
