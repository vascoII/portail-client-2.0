							Une demande de changement est actuellement en attente de traitement par les équipes Techem. Vous pouvez néamoins modifier les données de cette demande :
							</b></h5>
							{% endif %}
                            <div class="">

                                <span style="float:right;">

                                </span>
                            </div>
                            <div class="info clearfix">
                                <form class="form-horizontal code" name="edit-occupant" role="form">
                                    <div class="input-group code_form hidden-xs">
                                        <div class="form-group">
                                            <label class="col-xs-2"><i class="pull-right fa fa-user"></i></label>
                                            <div class="controls col-xs-10 buttonIn">
                                                <input type="text" class="form-control" placeholder="Saisir le nom de l'occupant" name="nameOccupant" data-field="nameOccupant"  
