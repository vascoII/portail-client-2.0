# Stage 0: Oracle Instant Client (runtime + SDK pour compilation OCI8)
FROM ghcr.io/oracle/oraclelinux8-instantclient:21 AS oracle
USER root
RUN dnf install -y oracle-instantclient-devel && dnf clean all && rm -rf /var/cache/dnf

# Stage 1: Build & Composer install
FROM php:8.3-fpm AS builder

WORKDIR /var/www/backend

# Install PHP extensions (sans pdo_mysql si on utilise uniquement Oracle)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git unzip wget libicu-dev libzip-dev libonig-dev zlib1g-dev libxml2-dev \
    libpng-dev libjpeg62-turbo-dev libfreetype6-dev libaio-dev && \
    docker-php-ext-configure intl && \
    docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j"$(nproc)" intl zip opcache soap gd mbstring && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copier Oracle Instant Client depuis l'image officielle (libs + headers pour PECL)
COPY --from=oracle /usr/lib/oracle/21/client64/lib /opt/oracle/instantclient_21_1
COPY --from=oracle /usr/include/oracle/21/client64 /opt/oracle/instantclient_21_1/sdk/include

RUN echo /opt/oracle/instantclient_21_1 > /etc/ld.so.conf.d/oracle-instantclient.conf && ldconfig

ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_21_1:$LD_LIBRARY_PATH
ENV ORACLE_HOME=/opt/oracle/instantclient_21_1

# Install PHP OCI8 extension (compilation manuelle pour passer instantclient au configure)
RUN pecl download oci8-3.2.0 && tar xf oci8-3.2.0.tgz && rm oci8-3.2.0.tgz && \
    cd oci8-3.2.0 && \
    phpize && \
    ./configure --with-php-config=/usr/local/bin/php-config --with-oci8=instantclient,/opt/oracle/instantclient_21_1 && \
    make -j"$(nproc)" && make install && \
    cd .. && rm -rf oci8-3.2.0 && \
    docker-php-ext-enable oci8

# Copy composer from official image
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy composer files and install dependencies (no dev)
COPY composer.json composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader --no-scripts

# Copy application code
COPY . .

# Exécuter les scripts post-install après avoir copié le code
RUN composer run-script post-install-cmd || true

# Optimize Symfony cache (si applicable)
RUN php bin/console cache:warmup --env=preview || true

# Stage 2: Final image
FROM php:8.3-fpm

WORKDIR /var/www/backend

# Copier Oracle Instant Client (runtime uniquement) depuis l'image officielle
COPY --from=oracle /usr/lib/oracle/21/client64/lib /opt/oracle/instantclient_21_1
RUN echo /opt/oracle/instantclient_21_1 > /etc/ld.so.conf.d/oracle-instantclient.conf && ldconfig

# Dépendance runtime pour OCI8 : libaio. Sur Bookworm le .so s'appelle libaio.so.1t64, oci8 cherche libaio.so.1
RUN apt-get update && \
    apt-get install -y --no-install-recommends libaio-dev && \
    (apt-get install -y --no-install-recommends libaio1t64 || apt-get install -y --no-install-recommends libaio1 || true) && \
    ( L=/usr/lib/$(dpkg-architecture -q DEB_HOST_MULTIARCH 2>/dev/null) && test -f "$L/libaio.so.1t64" && ln -sf libaio.so.1t64 "$L/libaio.so.1" ) || true && \
    ldconfig && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# PHP complet (extensions intl, gd, zip, oci8, etc.) depuis le builder
COPY --from=builder /usr/local /usr/local

# Application Symfony
COPY --from=builder /var/www/backend /var/www/backend

# S'assurer que le linker trouve libaio.so.1 après la copie de PHP
RUN ldconfig

ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_21_1:$LD_LIBRARY_PATH
ENV ORACLE_HOME=/opt/oracle/instantclient_21_1

ENV APP_ENV=preview APP_DEBUG=0

EXPOSE 9000
CMD ["php-fpm"]
