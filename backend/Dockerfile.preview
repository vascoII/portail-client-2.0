# ===============================================
# Stage 0 — Oracle Instant Client (libs + SDK)
# ===============================================
FROM ghcr.io/oracle/oraclelinux8-instantclient:21 AS oracle

USER root

# (Optionnel mais recommandé) — Zscaler côté Oracle stage
# Si le fichier n'existe pas, enlève ces deux lignes.
COPY ./public/tech/zscaler-root.crt /etc/pki/ca-trust/source/anchors/zscaler-root.crt
RUN update-ca-trust || true

# SDK pour pouvoir compiler oci8 contre Instant Client
RUN dnf install -y oracle-instantclient-devel \
 && dnf clean all \
 && rm -rf /var/cache/dnf


# ===============================================
# Stage 1 — BUILD (PHP + extensions + OCI8 offline)
# ===============================================
# ⚠️ On PIN l'image pour stabiliser Debian = Bookworm
ARG PHP_BASE=php:8.3.7-fpm-bookworm
FROM php:8.3.7-fpm-bookworm AS builder

WORKDIR /var/www/backend

# Cert Zscaler (pour composer, wget, git…)
# Si pas de cert Zscaler, commente ces deux lignes.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY ./public/tech/zscaler-root.crt /usr/local/share/ca-certificates/zscaler-root.crt
RUN update-ca-certificates || true

# Dépendances BUILD (versions -dev) pour compiler les extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip build-essential \
    libicu-dev libzip-dev zlib1g-dev \
    libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    libaio-dev libxml2-dev libonig-dev \
 && rm -rf /var/lib/apt/lists/*

# Oracle Instant Client (libs + headers) depuis stage oracle
COPY --from=oracle /usr/lib/oracle/21/client64/lib /opt/oracle/instantclient_21_1
COPY --from=oracle /usr/include/oracle/21/client64 /opt/oracle/instantclient_21_1/sdk/include

# Linker: Instant Client dans ld.so + mémoire env
RUN echo /opt/oracle/instantclient_21_1 > /etc/ld.so.conf.d/oracle-instantclient.conf && ldconfig
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_21_1
ENV ORACLE_HOME=/opt/oracle/instantclient_21_1

# ---- OCI8 OFFLINE (sans PECL online) ----
# ⚠️ Le fichier 'oci8-3.4.1.tgz' doit être à côté de ce Dockerfile
COPY ./public/tech/oci8-3.4.1.tgz .
RUN tar xf oci8-3.4.1.tgz \
 && cd oci8-3.4.1 \
 && phpize \
 && ./configure --with-php-config=/usr/local/bin/php-config --with-oci8=instantclient,/opt/oracle/instantclient_21_1 \
 && make -j"$(nproc)" \
 && make install \
 && docker-php-ext-enable oci8 \
 && cd .. \
 && rm -rf oci8-3.4.1 oci8-3.4.1.tgz

# Extensions PHP (compilées dans le builder)
RUN docker-php-ext-configure intl \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install -j"$(nproc)" intl zip opcache soap gd mbstring

# Composer (depuis l'image officielle)
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install Composer (prod)
COPY composer.json composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader --no-scripts

# Code applicatif
COPY . .

# Scripts post-install & warmup (non bloquants)
RUN composer run-script post-install-cmd || true
RUN php bin/console cache:warmup --env=preview || true


# ===============================================
# Stage 2 — RUNTIME
# ===============================================
FROM php:8.3.7-fpm-bookworm AS runtime

WORKDIR /var/www/backend

# Cert Zscaler au runtime (curl, symfony/http-client, etc.)
# Si pas de cert Zscaler, commente ces trois lignes.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY ./public/tech/zscaler-root.crt /usr/local/share/ca-certificates/zscaler-root.crt
RUN update-ca-certificates || true

# Instant Client (runtime only)
COPY --from=oracle /usr/lib/oracle/21/client64/lib /opt/oracle/instantclient_21_1
RUN echo /opt/oracle/instantclient_21_1 > /etc/ld.so.conf.d/oracle-instantclient.conf && ldconfig

# ⚠️ Dépendances RUNTIME (pas -dev) pour les extensions déjà compilées
# Bookworm => versions suivantes (stables)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libaio1 \
    libicu72 \
    libzip4 \
    libpng16-16 \
    libjpeg62-turbo \
    libfreetype6 \
    libxml2 \
 && rm -rf /var/lib/apt/lists/*

# (Pas nécessaire sur Bookworm, libaio.so.1 existe déjà.
#  On garde en "sécurité" un symlink conditionnel si la variante t64 apparaissait.)
RUN if [ -f /lib/x86_64-linux-gnu/libaio.so.1t64 ] && [ ! -f /lib/x86_64-linux-gnu/libaio.so.1 ]; then \
       ln -sf /lib/x86_64-linux-gnu/libaio.so.1t64 /lib/x86_64-linux-gnu/libaio.so.1 ; \
    fi && ldconfig

# Copier UNIQUEMENT ce qui est nécessaire depuis le builder :
# - les .so des extensions compilées
# - les .ini qui les activent
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Code applicatif
COPY --from=builder /var/www/backend /var/www/backend

# Env Oracle pour runtime
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient_21_1
ENV ORACLE_HOME=/opt/oracle/instantclient_21_1

# (Optionnel) Env Symfony par défaut
ENV APP_ENV=preview APP_DEBUG=1

EXPOSE 9000
CMD ["php-fpm"]